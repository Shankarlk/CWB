name: dockercompose12161421433046508295
services:
  cwb.apigateway:
    build:
      context: D:\DockerTestCWB\CWB-Latest\CWB
      dockerfile: CWB.ApiGateway/Dockerfile
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: CWB.ApiGateway
      target: base
    container_name: CWB.ApiGateway
    entrypoint:
      - tail
      - -f
      - /dev/null
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_LOGGING__CONSOLE__DISABLECOLORS: "true"
      ASPNETCORE_URLS: http://+:80
      DOTNET_USE_POLLING_FILE_WATCHER: "1"
      NUGET_FALLBACK_PACKAGES: /root/.nuget/fallbackpackages
    image: shankar84kl/cwbapigateway:dev
    labels:
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /root/.nuget/packages --additionalProbingPath /root/.nuget/fallbackpackages  "/app/bin/Debug/net5.0/CWB.ApiGateway.dll"'
      com.microsoft.visualstudio.debuggee.killprogram: /bin/sh -c "if PID=$$(pidof dotnet); then kill $$PID; fi"
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      cwb-network: null
    ports:
      - mode: ingress
        target: 443
        published: "9000"
        protocol: tcp
      - mode: ingress
        target: 80
        published: "9001"
        protocol: tcp
      - mode: ingress
        target: 80
        protocol: tcp
    restart: always
    tty: true
    volumes:
      - type: bind
        source: C:\Users\MicroApt\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\MicroApt\AppData\Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: D:\DockerTestCWB\CWB-Latest\CWB\CWB.ApiGateway
        target: /app
        bind:
          create_host_path: true
      - type: bind
        source: D:\DockerTestCWB\CWB-Latest\CWB
        target: /src
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\MicroApt\vsdbg\vs2017u5
        target: /remote_debugger
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\MicroApt\.nuget\packages\
        target: /root/.nuget/packages
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages
        target: /root/.nuget/fallbackpackages
        read_only: true
        bind:
          create_host_path: true
