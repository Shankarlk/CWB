@{
    ViewData["Title"] = "Item Master - Manufactured Part";

}

@model CWB.App.Models.ItemMaster.ManufacturedPartNoDetailVM
<input value="I-IM" type="hidden" id="hdn-nav-menu" />
<div class="content" id="ManufPartMain">
    <div class="row">

        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <!-- ================ -->
                    <div class="row m-0">
                        <div class="col-md-9">
                            <ul class="nav nav-tabs nav-pills navtab-bg">
                                <li class="nav-item" id="TabMPMain">
                                    <a href="#tab-1" aria-expanded="false" class="nav-link active">
                                        <span class="d-inline-block d-sm-none">Basic Info</span>
                                        <span class="d-none d-sm-inline-block">Basic Information</span>
                                    </a>
                                </li>
                                <li class="nav-item" id="TabHeadMakefrom">
                                    <a href="#tab-2" id="navHeadMakefrom" aria-expanded="true" class="nav-link ">
                                        <span class="d-inline-block d-sm-none">Make from</span>
                                        <span class="d-none d-sm-inline-block">Make from</span>
                                    </a>
                                </li>
                                <li class="nav-item" id="TabHeadBOM">
                                    <a href="#tab-3" id="navHeadBOM" aria-expanded="false" class="nav-link">
                                        <span class="d-inline-block d-sm-none">BOM</span>
                                        <span class="d-none d-sm-inline-block">BOM</span>
                                    </a>
                                </li>
                                <li class="nav-item" id="TabHeadBalloon">
                                    <a href="#tab-4" aria-expanded="false" class="nav-link">
                                        <span class="d-inline-block d-sm-none">Balloon</span>
                                        <span class="d-none d-sm-inline-block">Balloon</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-3 text-end">
                            <a asp-action="@ViewBag.ReturnUrl" asp-controller="ItemMasterInfo">
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                            </a>
                        </div>
                    </div>
                    <!-- ===============================================================  -->
                    <!-- ===============================================================  -->

                    <div class="tab-content">
                        <!-- ================ -->
                        <div class="tab-pane show active" id="tab-1">
                            <partial name="ManuF_Tab1" model=@Model />
                            <!-- ===================  -->
                            <div class="row mt-2">
                                @*<partial name="_ReferenceDocuments" />*@
                            </div>
                            <!-- end row -->
                        </div>
                        <div class="tab-pane" id="tab-2">
                            <partial name="ManuF_Tab2" model='new CWB.App.Models.ItemMaster.MPMakeFromVM{}' />
                        </div>
                        <div class="tab-pane" id="tab-3">
                            <partial name="ManuF_Tab3" model='new CWB.App.Models.ItemMaster.MPBomVM{}' />
                        </div>
                        <div class="tab-pane" id="tab-4"></div>
                        <!-- ================ -->
                        <!-- ======================= -->
                    </div>


                    <!-- ================ -->
                </div>
            </div>
        </div>
        <!-- ====== end col =========== -->
    </div>
    <!-- end row -->
</div>

<template id="csrmsearch">
    <button class="btn btn-sm btn-outline-purple" title="Select the Customer Supplied Input Material Type" data-plugin="tippy" data-tippy-placement="top" type="button" data-bs-toggle="modal" data-bs-target="#rm-select-cust">Select Input Part No *</button>
</template>

<template id="owrmsearch">
    <button class="btn btn-sm btn-outline-purple" title="Select the Input Material Type" data-plugin="tippy" data-tippy-placement="top" type="button" data-bs-toggle="modal" data-bs-target="#rm-select">Select Input Part No *</button>
</template>

<template id="otmpsearch">
    <button class="btn btn-sm btn-outline-purple" title="Select Other Part" data-plugin="tippy" data-tippy-placement="top" type="button" data-bs-toggle="modal" data-bs-target="#existing-part" onclick="downloadNLoadExistingParts()">Select Input Part No *</button>
</template>
