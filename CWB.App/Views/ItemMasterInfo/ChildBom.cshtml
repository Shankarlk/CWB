
<input value="I-IM" type="hidden" id="hdn-nav-menu" />
<div class="content">
    <div class="row" id="myRadioGroup">
        <div class="col-xl-12 col-md-12 col-sm-12 col-xs-12">
            <!-- ================= -->
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-11">
                            <h3 style="padding: 10px;">View Bill of Material</h3>
                        </div>
                        <div class="col-md-1 text-end">
                            <a asp-action="Index" asp-controller="InfoQueries" id="CloseBtn" style="font-size: large; color: #000;">
                                X
                            </a>
                        </div>
                        <!-- =============================  -->
                        <div class="col-md-12">
                            <hr class="mt-2">
                            <!-- ================================  -->
                            <div class="row">
                                <!-- ======================== -->
                                <!-- ======================== -->
                                <div class="col-md-2 mb-2">
                                    <label class="form-label">Customer</label>
                                    <select class="form-select form-select-sm" aria-label="form-select-sm"
                                            title="" data-plugin="tippy" data-tippy-placement="top" id="searchCustomer">
                                        <option value="">==========</option>
                                    </select>
                                </div>
                                <div class="col-md-2 mb-2">
                                    <label class="form-label">Part Number</label>
                                    <input class="form-control form-control-sm w-100" type="text" title=""
                                           data-plugin="tippy" data-tippy-placement="top" placeholder="Enter Part Number"
                                           id="searchPartNo">
                                </div>
                                <div class="col-md-2 mb-2">
                                    <label class="form-label">Part Desc</label>
                                    <input class="form-control form-control-sm w-100" type="text" title=""
                                           data-plugin="tippy" data-tippy-placement="top" placeholder="Enter Part Description"
                                           id="searchPartDesc">
                                </div>
                                <!-- ======================== -->
                                <!-- ======================== -->
                                <div class="col-md-12">
                                    <div class="row">
                                        <div class="table-responsive table-he-250">
                                            <table class="table table-sm table-bordered w-100 text-center" id="grid1">
                                                <thead class="  table-info th-sti">
                                                    <tr class="table-border-bottom">
                                                        <th>Customer</th>
                                                        <th>Part No </th>
                                                        <th>Description</th>
                                                        <th width="5%"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <hr>
                                </div>
                                <div class="col-md-12">
                                    <h5>BOM for Selected Part No / Desc  : <span id="spanPartNo"></span> / <span id="spanPartDesc"></span></h5>
                                </div>
                                <div class="col-md-12">
                                    <div class="row">
                                        <div class="table-responsive table-he-250">
                                            <table class="table table-sm table-bordered w-100 text-center" id="grid2">
                                                <thead class="  table-info th-sti">
                                                    <tr class="table-border-bottom">
                                                        <th>Part No </th>
                                                        <th>Description</th>
                                                        <th>Part Type</th>
                                                        <th width="5%"></th>
                                                        <th width="5%"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <!-- =========== -->
                            </div>
                            <!-- =========== -->
                            <!-- =============================================  -->
                            <!-- =============  end row  ================  -->
                            <!-- end accordion -->
                        </div>
                        <!-- =============================  -->
                    </div>
                </div>
            </div>
            <!-- end card body -->
            <!-- ================= -->
        </div>
        <!-- end card -->
        <!-- ======================================================================== -->
    </div>
    <!-- end col -->
</div>

<div class="modal fade modal-fullscreen-xl-down" id="viewDoc" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" style="display: none;" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bxs-modal">
            <div class="modal-header">
                <h4 class="modal-title" id="mySmallModalLabel">View Documents</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-3 mb-2">
                        <select class="form-select form-select-sm" id="SelectDocType" data-plugin="tippy" data-tippy-placement="top" data-tippy="" data-original-title="Select Part No from Drop Down"><option value="0">--Select--</option><option value="1">DocType</option></select>
                    </div>
                    <!-- =============== -->
                    <div class="col-md-3 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-purple" id="BtnViewDoc">View</button>
                    </div>
                    <!-- =============== -->
                    <!-- ========================= -->
                    <div class="col-md-12 dott-bord-r mt-3">
                        <div class="table-responsive table-he-150">
                            <table class="table table-sm table-bordered w-100 text-center">
                                <thead class="table-info th-sti">
                                    <tr class="table-border-bottom">
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Document Type : <span id="VPDocType"></span></td>
                                        <td>Uploaded by <span id="VPUploadedBy"></span> on <span id="VPUploadedOn"></span></td>
                                        <td>Part No / Desc : <span id="VPPartNo">T-1011A</span> / <span id="VPPartDesc">Top Tube</span></td>
                                        @*<td>Customer : <span id="VPCustomer">TISS LTD</span> </td>*@
                                    </tr>
                                    <tr>
                                        <td>Retention Date : <span id="VPRetention"></span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- ========================= -->
                    <div class="col-md-12">
                        <iframe id="fileViewer" src="" style="width: 100vw; height: 100vh;"></iframe>
                    </div>
                    <!-- ========================= -->
                </div>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div>

<template id="grid1Row">
    <tr>
        <td>{company}</td>
        <td>{partNo}</td>
        <td>{description}</td>
        <td>
            <div class="dropdown float-center">
                <a href="#"
                   class="dropdown-toggle arrow-none card-drop"
                   data-bs-toggle="dropdown"
                   aria-expanded="false">
                    <i class="mdi mdi-dots-vertical"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-end">
                    <a href="javascript:void(0);"
                       class="dropdown-item" data-partid="{partId}" data-partno="{partNo}" data-partdesc="{description}" data-parttype="{masterDisplay}" onclick="ShowGrid2(this)">Show BOM</a>
                </div>
            </div>
        </td>
    </tr>
</template>
<template id="grid2Row">
    <tr>
        <td>{partNo}</td>
        <td>{description}</td>
        <td>{masterPartType}</td>
        <td>
            <a href="javascript:void(0);" data-partid="{partId}" data-customername="{company}" data-partno="{partNo}" data-partdesc="{description}" data-parttype="{masterPartType}" data-bs-toggle="modal" data-bs-target="#viewDoc">
                <i class="fas fa-eye btn btn-sm"></i><!--style="color: #007bff;"-->
            </a>
        </td>
        <td>
            <div class="dropdown float-center">
                <a href="#"
                   class="dropdown-toggle arrow-none card-drop"
                   data-bs-toggle="dropdown"
                   aria-expanded="false">
                    <i class="mdi mdi-dots-vertical"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-end">
                    <a href="/ItemMasterInfo/editpart?partId={partId}&partType={masterPartType}&returnUrl=ChildBom"
                       class="dropdown-item">Show Details</a>
                </div>
            </div>
        </td>
    </tr>
</template>
@section scripts {
    <script src="~/js/ViewChildBom.js"></script>
}