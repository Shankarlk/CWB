@{
    ViewData["Title"] = "View Item Master - Manufactured Part";

}
@model CWB.App.Models.ItemMaster.ManufacturedPartNoDetailVM
<partial name="ManufPart" model=@Model />


@section scripts {
    <script>
        const form = document.getElementById("ManufPartForm");

        // Make all input fields readonly or disabled
        form.querySelectorAll("input").forEach(el => {
            if (el.type === "checkbox" || el.type === "radio") {
                el.disabled = true;
            } else {
                el.readOnly = true;
            }
        });

        form.querySelectorAll("textarea").forEach(el => {
            el.readOnly = true;
        });

        form.querySelectorAll("select").forEach(el => {
            el.disabled = true;
        });

        // Also disable buttons if needed
        form.querySelectorAll("button").forEach(el => {
            el.disabled = true;
        });
    </script>
    <script src="~/js/addfunctions.js"></script>
    <script src="~/js/ItemMaster/supplier.js"></script>
    <script src="~/js/ItemMaster/rmselects.js"></script>
    <script src="~/js/contact-model.js"></script>
    <script src="~/js/InfoManufpart.js"></script>
    <script src="~/js/contacts.js"></script>
    <script src="~/js/searchparts.js"></script>
    <script src="~/js/searchpartsbof.js"></script>
    <script>
        var modelObj = @Html.Raw(Json.Serialize(Model));
        modelObj["Edit"] = true;
   //     $('#ManufPartForm').validate();
    </script>
}