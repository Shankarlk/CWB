<!-- Standard modal content -->
<div id="add-dept" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="standard-modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="standard-modalLabel">Add Department</h4>
                <button type="button" id="AddDeptClose" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="Post" id="DepartmentForm" onsubmit="return false;" class="parsley-examples">
                    <div class="row">
                        <!-- ----- -->
                        <label class="form-label col-md-4 mb-2">Department Name <span class="text-danger">*</span></label>
                        <div class="col-md-8 mb-2">
                            <input class="form-control form-control-sm" type="text" name="Name" id="Name" required />
                        </div>
                        <div class="invalid-feedback">
                            Please enter department name!
                        </div>
                        <!-- ----- -->
                        @*<label class="form-label col-md-4 mb-2">Section  Name </label>
        <div class="col-md-8 mb-2">
            <input class="form-control form-control-sm" type="text" name="Section" id="Section" value="-">
        </div>*@
                        <!-- ----- -->
                        <label class="form-label col-md-4 mb-2">Location</label>
                        <div class="col-md-8 mb-2">
                            <select name="PlantId" id="PlantId" class="form-select form-select-sm">
                            </select>
                        </div>
                        <!-- ----- -->
                        <label class="form-label col-md-4 mb-2" id="lblActfun">Activity / Function</label>
                        <div class="col-md-8 mb-2" id="ActFunDiv">
                            <textarea name="Activity" id="Activity" class="form-control form-control-sm">....</textarea>
                        </div>
                        <!-- ----- -->
                        <div class="col-md-12 mb-2">
                            <label class="form-label  mb-2">Production Department / Shop</label>
                            <input class="form-check-input m-l-5" name="ProdDept" id="ProdDept" type="checkbox" value="false">
                        </div>
                        <!-- ----- -->
                        <!-- ----- -->
                        <label class="form-label col-md-4 mb-2" id="lblNoOfShift">No of Shifts of Operation</label>
                        <div class="col-md-8 mb-2" id="NoOfShiftsDiv">
                            <select id="NoOfShifts" name="NoOfShifts" class="form-select form-select-sm" aria-label="form-select-sm">
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                            </select>
                        </div>
                        <!-- ----- -->
                        <div class="col-md-12 mt-2 text-end">
                            <input type="text" name="DepartmentId" id="DepartmentId" value="0" hidden required />
                            <input type="text" name="Part_Of" id="Part_Of" value="0" hidden required />
                            <input type="text" name="Level_No" id="Level_No" value="0" hidden required />
                            <input type="submit" id="SaveDept" class="btn btn-sm btn-primary" value="Save" />
                        </div>
                    </div>
                </form>
                <div class="row mt-1">
                    <h5>Role List for Department Position</h5>
                    <div class="col-md-12">
                        <div class="table-responsive table-he-330">
