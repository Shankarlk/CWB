<input value="C-OR" type="hidden" id="hdn-nav-menu" />
<div class="content">
    <div class="card">
        <div class="card-body">
            <h4 class="pb-1 mt-1 mb-1">Department Structure</h4>
            @{
                List<CWB.App.Models.EmployeeMaster.Role_UI_ListVM> permissionResult = null;
                var permissionsJson = HttpContextAccessor.HttpContext.Session.GetString("Permissions");
                if (permissionsJson != null)
                {
                    permissionResult = Newtonsoft.Json.JsonConvert.DeserializeObject<List<CWB.App.Models.EmployeeMaster.Role_UI_ListVM>>(permissionsJson);

                }
            }
            <div class="tab-pane show active" id="tab222">
                <div class="row">
                    <div class="table-responsive mb-2 table-he-350">
                        <table class="table table-sm table-bordered w-100 text-center" id="DeptTable">
                            <thead class="table-info th-sti">
                                <tr class="table-border-bottom">
                                    <th>Level 1</th>
                                    <th>Level 2 </th>
                                    <th>Level 3</th>
                                    <th>Level 4 </th>
                                    <th>Level 5</th>
                                    <th>Role</th>
                                    <th width="5%"></th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-12 mt-1">
                        @if (permissionResult != null)
                        {
                            @if (permissionResult.Any(r => r.Menu3 == "Add / Edit Department"))
                            {
                                var pr = permissionResult.Where(r => r.Menu3 == "Add / Edit Department").FirstOrDefault();
                                if (pr.PermissionId >= 3)
                                {
                                    <button onclick="SetOp('add');$('#add-dept').modal('show');" class="btn btn-sm btn-primary" data-op="add" data-bs-toggle="modal">Add New Level</button>
                                }
                                else
                                {
                                    <button onclick="SetOp('add');$('#add-dept').modal('show');" class="btn btn-sm btn-primary" data-op="add" data-bs-toggle="modal" disabled>Add New Level</button>
                                }
                            }


                        }
                        else
                        {
                            <button onclick="SetOp('add');$('#add-dept').modal('show');" class="btn btn-sm btn-primary" data-op="add" data-bs-toggle="modal">Add New Level</button>
                        }

                    </div>
                </div>
                <!-- -------------  -->
            </div>
            <!-- ===============  -->
            <!-- ===============  -->
            <!-- ==================== -->
            <!-- ==================== -->
        </div>
    </div>
    <!-- end card -->
</div>
<!-- end Container -->
<!----content-page ends----->
<!----wrapper ends----->
