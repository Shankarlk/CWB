                </div>
            </div>
        </td>
    </tr>
</template>
<template id="DeptRow">
    <tr>
        <td>{level1}</td>
        <td>{level2}</td>
        <td>{level3}</td>
        <td>{level4}</td>
        <td>{level5}</td>
        <td>{roleName}</td>
        @*<td>{activity}</td>*@
        <!--activity: null
        departmentId: 1
        name: "Production"
        noOfShifts: 3
        plantId: 1
        plantName: "test"-->
        <td>
            <div class="dropdown float-center">
                <a href="#" class="dropdown-toggle arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false"><i class="mdi mdi-dots-vertical"></i></a>
                <div class="dropdown-menu dropdown-menu-end">
                    @if (permissionResult != null)
                    {
                        @if (permissionResult.Any(r => r.Menu3 == "Add / Edit Department"))
                        {
                            var pr = permissionResult.Where(r => r.Menu3 == "Add / Edit Department").FirstOrDefault();
                            if (pr.PermissionId >= 3)
                            {
                                <a href="javascript:void(0);" onclick="SetOp('edit');"
                                   data-deptid="{departmentId}" data-name="{name}"
                                   data-activity="{activity}" data-noOfShifts="{noOfShifts}"
                                   data-plantId="{plantId}" data-plantName="{plantName}"
                                   data-proddept="{prodDept}" data-section="{section}" data-partof="{part_Of}"
                                   class="dropdown-item" data-bs-toggle="modal"
                                   data-bs-target="#add-dept">Edit</a>
                                <a href="javascript:void(0);" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#add-dept" data-deptid="{departmentId}" data-levelno="{level_No}">Add Level Below</a>
                            }
                            else
                            {
                            }
                            if (pr.PermissionId >= 4)
                            {
                                <a href="javascript:void(0);" onclick="DelDept('{name}',{departmentId});" class="dropdown-item">Delete</a>
                            }
                        }


                    }
                    else
                    {
                        <a href="javascript:void(0);" onclick="SetOp('edit');"
                           data-deptid="{departmentId}" data-name="{name}"
                           data-activity="{activity}" data-noOfShifts="{noOfShifts}"
                           data-plantId="{plantId}" data-plantName="{plantName}"
                           data-proddept="{prodDept}" data-section="{section}" data-partof="{part_Of}"
                           class="dropdown-item" data-bs-toggle="modal"
                           data-bs-target="#add-dept">Edit</a>
                        <!-- item-->
                        @*<a href="javascript:void(0);" class="dropdown-item"
                            data-bs-toggle="modal"
                            data-deptid="{departmentId}"
                            data-bs-target="#Addsection"
                            >Add Section</a>*@
                        <a href="javascript:void(0);" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#add-dept" data-deptid="{departmentId}" data-levelno="{level_No}">Add Level Below</a>
                        <a href="javascript:void(0);" onclick="DelDept('{name}',{departmentId});" class="dropdown-item">Delete</a>
                        <!-- item-->
                        <!-- item-->
                        <!--<a href="javascript:void(0);" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#">UI Access</a>-->
                        <!-- item-->
                        <!--<a href="javascript:void(0);" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#">Workflow Access</a>-->
                    }
                    <!-- item-->
                    <!-- item-->
                </div>
            </div>
        </td>
    </tr>
</template>
