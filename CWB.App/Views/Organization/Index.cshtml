                                    </tr>
                                </thead>
                                <tbody>

                                    <!-- -------------  -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col">
                        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addRole">Add Role</button>
                    </div>
                </div>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

