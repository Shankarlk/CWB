
@{
    ViewData["Title"] = "View SubCon Loading";
}
<input value="I-VSC" type="hidden" id="hdn-nav-menu" />
<div class="content">
    <div class="row">
        <div class="col-xl-12 col-md-12 col-sm-12 col-xs-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12">
                            <h5 class="mb-4">Parts loaded in SubCon</h5>
                        </div>
                        <div class="col-md-2 mb-2">
                            <label class="form-label">SubCon </label>
                            <select class="form-select form-select-sm" aria-label="form-select-sm"
                                    id="P5Subcon" title="" data-plugin="tippy" data-tippy-placement="top">
                                <option value="">==========</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-2">
                            <label class="form-label">Part No / Desc </label>
                            <input type="text" id="P5PartNo" class="form-control form-control-sm" placeholder="Part No / Desc" />
                        </div>
                        <div class="col-md-12" id="P6partInspectPlanGridDiv">
                            <div class="col-md-12">
                                <div class="table-responsive table-he-330">
                                    <table id="P5Grid"
                                           class="table table-sm table-bordered w-100 text-center">
                                        <thead class="  table-info th-sti">
                                            <tr class="table-border-bottom">
                                                <th>SubCon</th>
                                                <th>Work Ref </th>
                                                <th>Part No / Desc</th>
                                                <th>Starting Opr No</th>
                                                <th>WO Qnty</th>
                                                <th>Qnty Sent</th>
                                                <th>Qnty Recd</th>
                                                <th>Bal to Receive</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- -------------  -->
                                            <!-- -------------  -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- ========================= -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<template id="P5GridRow">
    <tr>
        <td>{supplier}</td>
        <td>{woNumber}</td>
        <td>{partNo}</td>
        <td>{oprNoName}</td>
        <td>{plan_Qnty}</td>
        <td>{qntySent}</td>
        <td>{qntyRecd}</td>
        <td>{balToReceive}</td>
    </tr>
</template>
@section Scripts {
    <script src="~/js/ViewSubConLoad.js"></script>
}