@{
    ViewData["Title"] = "Routing";
}
@model CWB.App.Models.Routing.RoutingListItemVM
<input value="M-IR" type="hidden" id="hdn-nav-menu" />
<div class="content">
    <div class="row">
        <div class="col-xl-12 col-md-12 col-sm-12 col-xs-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <!-- ================================ -->
                        <!-- ================================ -->
                        <div class="col-md-12 mt-n2" hidden>
                            <ul class="nav nav-tabs nav-pills nav-justified navtab-bg font-12">
                                <li class="nav-item" id="RoutingAvailable">
                                    <a href="#rs2" data-bs-toggle="tab" aria-expanded="true" class="nav-link active">
