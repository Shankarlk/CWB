<div class="modal fade" id="po-Qnty" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bxs-modal">
            <form id="poresumeform" onclick="return false;">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">Reason for Customer PO Qnty Change * *</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <textarea id="POQntyComment" name="Comment" class="form-control" placeholder="Enter Comments"></textarea>
                </div>
                <input type="text" hidden id="POQLogId" name="POLogId" value="0" />
                <input type="text" hidden id="POQCustomerOrderId" name="CustomerOrderId" value="0" />
                <input type="text" hidden id="POQSalesOrderId" name="SalesOrderId" value="0" />
                <input type="text" hidden id="POQUser" name="User" value="Delete" />
                <input type="text" hidden id="POQNewValue" name="NewValue" value="0" />
                <input type="text" hidden id="POQOldValue" name="OldValue" value="0" />
                <input type="text" hidden id="POQEvent" name="Event" value="Delete" />
                <input type="text" hidden id="POQPartId" name="PartId" value="0" />
                <div class="modal-footer">
                    <span id="POQntyCust"></span>
                    <button id="BtnPOQnty" type="button" class="btn btn-primary btn-sm">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="po-DateChng" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bxs-modal">
            <form id="poresumeform" onclick="return false;">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">Reason for Customer PO Qnty Change * *</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <textarea id="PODateComment" name="Comment" class="form-control" placeholder="Enter Comments"></textarea>
                </div>
                <input type="text" hidden id="PODLogId" name="POLogId" value="0" />
                <input type="text" hidden id="PODCustomerOrderId" name="CustomerOrderId" value="0" />
                <input type="text" hidden id="PODSalesOrderId" name="SalesOrderId" value="0" />
                <input type="text" hidden id="PODUser" name="User" value="Delete" />
                <input type="text" hidden id="PODNewValue" name="NewValue" value="0" />
                <input type="text" hidden id="PODOldValue" name="OldValue" value="0" />
                <input type="text" hidden id="PODEvent" name="Event" value="Delete" />
                <input type="text" hidden id="PODPartId" name="PartId" value="0" />
                <div class="modal-footer">
                    <button id="BtnPODate" type="button" class="btn btn-primary btn-sm">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

