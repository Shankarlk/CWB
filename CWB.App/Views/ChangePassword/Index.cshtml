                    <div class="col-sm-6">
                        <div class="card">
                            <div class="card-body">
                                <div class="col-md-12">
                                    <label class="form-label mb-1">Current Password</label>
                                    <input type="password" class="form-control w-50" placeholder="Current Password" id="CurPassword"
