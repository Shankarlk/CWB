@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "WIP Control";
}
<input value="B-BP" type="hidden" id="hdn-nav-menu" />

<div class="content">
    <div class="container mt-4">
        <h4>Operations Settings </h4>
        <hr class="mt-2">
        <div class="contianer">
            <div class="row ">
                <div class="col-md-3">
                    <div class="card p-1">
                        <div class="row">
                            <h5>Inward</h5>
                            <div class="col-md-12 text-center">
                                <button class="btn btn-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#inwardDoc">Associate Inwarding Docs  with Document Type </button>
                            </div>
                            <div class="col-md-12">
                                <div class="d-flex align-items-center justify-content-between mb-3 mt-2">
                                    <h6 class="mb-0">Enable Upload of Inwarding Documents</h6>
                                    <input class="form-check-input ms-auto me-3" type="checkbox" id="EnableUploadofInwardingDocuments">
                                </div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="mb-0">Enable Upload of Supplier Inspection Documents</h6>
                                    <input class="form-check-input ms-auto me-3" type="checkbox" id="EnableUploadofSupplierInspectionDocuments">
                                </div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="mb-0">Enable Printing of Inwarding Labels</h6>
                                    <input class="form-check-input ms-auto me-3" type="checkbox" id="EnablePrintingofInwardingLabels">
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card p-1">
                        <div class="row">
                            <h5>Inspection</h5>
                            <div class="col-md-12 text-center">
                                <button class="btn btn-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#inspectDoc">Associate Inward Inpsection Docs with Document Type </button>
                            </div>
                            <div class="col-md-12 text-center">
                                <button class="btn btn-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#lineDoc">Associate Line Inpsection Docs with Document Type </button>
                            </div>
                            <div class="col-md-12 text-center">
                                <button class="btn btn-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#finalDoc">Associate Final Inpsection Docs with Document Type </button>
                            </div>
                            <div class="col-md-12 text-center">
                                <button class="btn btn-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#rcacaDoc">Associate RCA & CA Docs with Document Type </button>
                            </div>
                            <div class="col-md-12">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="mb-0">Enable Viewing of Part Inspection Documents</h6>
                                    <input class="form-check-input ms-auto me-2" type="checkbox" id="EnableViewingofPartInspectionDocuments">
                                </div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="mb-0">Enable Viewing of Supplier Inspection Documents</h6>
                                    <input class="form-check-input ms-auto me-2" type="checkbox" id="EnableViewingofSupplierInspectionDocuments">
                                </div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="mb-0">Enable Upload of Our Inward Inspection Documents</h6>
                                    <input class="form-check-input ms-auto me-2" type="checkbox" id="EnableUploadofOurInwardInspectionDocuments">
                                </div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="mb-0">Enable Upload of Root Cause Analysis & Corrective Action Report</h6>
                                    <input class="form-check-input ms-auto me-2" type="checkbox" id="EnableUploadofRootCauseAnalysis&CorrectiveActionReport">
                                </div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="mb-0">Enable Printing of Inspection Labels</h6>
                                    <input class="form-check-input ms-auto me-2" type="checkbox" id="EnablePrintingofInspectionLabels">
                                </div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="mb-0">Allow User with Permission to open NC Disposal UI without RCA & CA uploaded</h6>
                                    <input class="form-check-input ms-auto me-2" type="checkbox" id="AllowUserwithPermissiontoopenNCDisposalUIwithoutRCA&CAuploaded">
                                </div>
                            </div>

                            <div class="col-md-12 text-center">
                                <button class="btn btn-primary w-50" id="UiEnableBtn">Save</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card p-1">
                        <div class="row">
                            <h5>Non Conformance</h5>
                            <div class="col-md-12 text-center">
                                <button class="btn btn-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#NcPopup1">NC Work Step Template</button>
                            </div>
                            <div class="col-md-12 text-center">
                                <button class="btn btn-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#NcPopup4">NC Disposal Decision List</button>
                            </div>
                            <div class="col-md-12 text-center">
                                <button class="btn btn-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#NcPopup6">Customer Response vs NC Disposal Decision Matrix</button>
                            </div>
                            <div class="col-md-12 text-center">
                                <button class="btn btn-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#NcPopup8">Set NC Disposal Decision Malers (Level 1 / 2)</button>
                            </div>
                            <div class="col-md-12">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="mb-0">Allow Loading to Prodn if NC not Closed</h6>
                                    <input class="form-check-input ms-auto me-2" type="checkbox"
                                           id="AllowLoadingtoProdnifNCnotClosed">
                                </div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="mb-0">Allow Loading to Prodn if Docs not approved</h6>
                                    <input class="form-check-input ms-auto me-2" type="checkbox"
                                           id="AllowLoadingtoProdnifDocsnotapproved">
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card p-1">
                        <div class="row">
                            <h5>Machine Loading</h5>
                            <div class="col-md-12 text-center">
                                <button class="btn btn-primary w-100 mb-2" data-bs-toggle="modal"
                                        data-bs-target="#McPopup9">
                                    Set Matl. Coverage in Shop
                                </button>
                            </div>
                            <div class="col-md-12 text-center">
                                <button class="btn btn-primary w-100 mb-2" id="TimeSlotSettingsBtn">
                                    Timeslot Settings
                                </button>
                            </div>
                            <div class="col-md-12 text-center">
                                <button class="btn btn-primary w-100 mb-2" data-bs-toggle="modal"
                                        data-bs-target="#McPopup12">
                                    Mc Not Avl Reason List
                                </button>
                            </div>
                            <div class="col-md-12 text-center">
                                <button class="btn btn-primary w-100 mb-2" data-bs-toggle="modal"
                                        data-bs-target="#McPopup14">
                                    Simulation Settings
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
    <!-- end col -->
</div>

