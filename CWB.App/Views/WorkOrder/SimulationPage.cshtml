                                            <th style="font-weight: bold;font-size: large;" class="text-center" colspan="2">WO Status Overview</th>
                                            <th class="text-center">Assembly</th>
                                            <th width="20%" class="text-center">Child Manf Part</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td rowspan="4" class="text-center">Waiting for M/c Slot<br>(not in M/c Queue)</td>
                                            <td rowspan="2" style="font-weight: bold;">Parent WO Released - Ready for Production</td>
                                            <td>Ready for Production (Material Available) </td>
                                            <td class="text-center" id="ReadAssy">0</td>
                                            <td class="text-center" id="ReadCMp">0</td>
                                        </tr>
                                        <tr>
                                            <td>Waiting for Material</td>
                                            <td class="text-center" id="WAssy">0</td>
                                            <td class="text-center" id="WCmp">0</td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" class="text-end">Rework WO</td>
                                            <td class="text-center" id="RwkAssy">0</td>
                                            <td class="text-center" id="RwkCmp">0</td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" class="text-end">Non Plan Work</td>
                                            <td colspan="2" class="text-center" id="NonAssy">0</td>
                                        </tr>
                                        <tr>
                                            <td rowspan="4" class="text-center">In M/c Queue</td>
                                            <td rowspan="2" style="font-weight: bold;">Child / Parent WO </td>
                                            <td>Ready for Production (Material Available) </td>
                                            <td class="text-center" id="InMcQueRAssy">0</td>
                                            <td class="text-center" id="InMcQueRCmp">0</td>
                                        </tr>
                                        <tr>
                                            <td>Waiting for Material</td>
                                            <td class="text-center" id="InMcQueWAssy">0</td>
                                            <td class="text-center" id="InMcQueWCmp">0</td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" class="text-end">Rework WO</td>
                                            <td class="text-center" id="InMcQueRwkAssy">0</td>
                                            <td class="text-center" id="InMcQueRwkCmp">0</td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" class="text-end">Non Plan Work</td>
                                            <td colspan="2" class="text-center" id="InMcQueNon">0</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="row m-5">
                                <div class="d-grid gap-2">
                                    <button class="btn btn-outline-primary" data-bs-target="#Popup1" data-bs-toggle="modal"
