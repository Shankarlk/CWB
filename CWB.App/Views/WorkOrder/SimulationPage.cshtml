                                <button class="btn btn-outline-success" id="CountinueBtn">Continue <i class="fas fa-play"></i></button>
                                <button class="btn btn-outline-danger" id="CancelBtn">Cancel <i class="fas fa-times"></i></button>
                            </div>

                            <div class="col-md-12">
                                <div class="row">
                                    <div class="table-responsive table-he-250">
                                        <table class="table table-sm table-bordered w-100 text-center" id="SimWoGrid">
