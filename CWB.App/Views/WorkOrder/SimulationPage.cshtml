                                                <tr class="table-border-bottom">
                                                    <th>Work Order # </th>
                                                    <th>Customer</th>
                                                    <th>Build to Stock</th>
                                                    <th>Part No / Desc</th>
                                                    <th>Part Type </th>
                                                    <th>WIP</th>
                                                    <th>Plan WO Qnty</th>
                                                    <th>Reqd Compl Dt</th>
                                                    <th>Cur Plan Qnty</th>
                                                    <th>PS Start Date</th>
                                                    <th>PS Compl Date </th>
                                                    <th>CS Start Date </th>
                                                    <th>CS Compl Date </th>
                                                    <th>Act Start Date </th>
                                                    <th>Critical Part </th>
                                                    <th>Data Changed </th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- -------------  -->
                                                <!-- -------------  -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <h6>PS : Previous Simulation&nbsp;&nbsp;&nbsp;&nbsp;CS : Current Simulation</h6>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Actions -->
                    <div class="row mt-1">
                        <div class="col-md-12 mb-3">
                            @if (permissionResult != null)
                            {
                                @if (permissionResult.Any(r => r.Menu4 == "Show Child WO Status"))
                                {
                                    <button class="btn btn-outline-primary ms-3" onclick="window.location.href='/S!M@l@T!LO0'">
                                        Show Child WO Status
                                    </button>
                                }
                                @if (permissionResult.Any(r => r.Menu4 == "Machine List"))
                                {
                                    <button class="btn btn-outline-primary ms-3" onclick="window.location.href='/M@H1NE!P'">Machine List</button>
                                }
                                @if (permissionResult.Any(r => r.Menu4 == "SubCon List"))
                                {
                                    <button class="btn btn-outline-primary ms-3" onclick="window.location.href='/SYBC0!NK'">SubCon List</button>
                                }
                            }
                            else
                            {
                                <button class="btn btn-outline-primary ms-3" onclick="window.location.href='/S!M@l@T!LO0'">
