<template id="MoveGridRow">
    <tr>
        <td>
            <input type="checkbox" class="row-checkbox" />
        </td>
        <td>{partNo}</td>
        <td>{routingName}/{oprNo}</td>
        <td>{fromSender}</td>
        <td>{toSender}</td>
        <td>{partStatus}</td>
        <td>{qnty}</td>
        <td>{updateResp}</td>
        <td>{qnty_Mismatch}</td>
        <td>{misMatchStatus}</td>
        <td hidden>{inv_Trans_LogId}</td>
        <td>
            <div class="dropdown float-center">
                <a href="#"
                   class="dropdown-toggle arrow-none card-drop"
                   data-bs-toggle="dropdown"
                   aria-expanded="false">
                    <i class="mdi mdi-dots-vertical"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-end">
                    <a href="javascript:void(0);"
                       class="dropdown-item"
                       data-fromsend="{fromSender}"
                       data-tosend="{toSender}"
                       data-rout="{routingName}"
                       data-opr="{oprNo}"
                       data-qntymis="{qnty_Mismatch}"
                       data-qntycom="{qnty_Mismatch_Comment}"
                       data-partstatus="{partStatus}" data-partid="{partId}"
                       data-partno="{partNo}" data-qnty="{qnty}"
                       data-id="{inv_Trans_LogId}"
                       data-bs-toggle="modal" data-bs-target="#popup16">Update Receipt</a>
                    <a href="javascript:void(0);"
                       class="dropdown-item"
                       data-fromsend="{fromSender}"
                       data-tosend="{toSender}"
                       data-rout="{routingName}"
                       data-opr="{oprNo}"
                       data-partstatus="{partStatus}" data-partid="{partId}"
                       data-partno="{partNo}" data-qnty="{qnty}"
                       data-id="{inv_Trans_LogId}"
                       data-bs-toggle="modal" data-bs-target="#popup17">Update Multiple Select OK</a>
                    
                    @*<a href="javascript:void(0);"
                       class="dropdown-item"
                       data-fromsend="{fromSender}"
                       data-tosend="{toSender}"
                       data-rout="{routingName}"
                       data-opr="{oprNo}"
                       data-partstatus="{partStatus}" data-partid="{partId}"
                       data-partno="{partNo}" data-qnty="{qnty}"
                       data-id="{inv_Trans_LogId}"
                       data-bs-toggle="modal" data-bs-target="#popup18">Move to Scrap (for Rejected Parts)</a>*@
                    

                </div>
            </div>
        </td>
    </tr>
</template>



