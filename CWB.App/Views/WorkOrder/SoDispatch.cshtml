<div class="modal fade" id="popup12" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bxs-modal">
            <div class="modal-header position-relative">
                <h5 class="modal-title" id="staticBackdropLabel">
                    Dispatch Quantity Update
                    <br>
                    Part No / Desc : <span id="P12PartNo"></span> /  <span id="P12PartDesc"></span>  <br>
                    Customer :  <span id="P12Cust"></span> <br>
                    PO No :  <span id="P12Po"></span> <br>
                    Bal Disp.Qnty :  <span id="P12BalQnty"></span> <br>
                    Suggested Dispatch Qnty :  <span id="P12SuggestedQnty"></span> <br>
                    <label id="P12RedistributionRow"> Qnty Available for Redistribution:  <span id="P12QntyRedistribution"></span> </label><br>
                    Qnty on Hand Available for Dispatch :  <span id="P12QoH"></span>
</h5>
                <button type="button" class="btn-close position-absolute top-0 end-0 m-2" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">

                    <label class="col-md-4 form-label mb-2">
                        Qnty to Dispatch *
                    </label>
                    <div class="col-md-6 mb-2" data-plugin="tippy" data-tippy-placement="top"
                         data-tippy=""
                         data-original-title="">
                        <input type="text" class="form-control form-control-sm w-25" id="P12FinQnty">
                        <label id="P12FinQntyError"
                               class="text-danger mt-1"
                               style="display:none;">
                            Quantity entered should not be greater than Bal Disp.Qnty. or Quantity On hand available for Dispatch
                            Please check and reenter.
                        </label>
                        <input type="text" class="form-control form-control-sm w-50" id="P12SoId" hidden>
                        <input type="hidden" id="P12SoAllocId">
                    </div>
                    <div class="col-md-10 text-end">
                        <button class="btn btn-primary btn-sm" id="P12Save">Save</button>
                    </div>
                    <div class="col-md-12 mt-2" id="P12GridDiv" style="display: none;">
                        <div class="table-responsive table-he-330">
                            <table id="P12Grid"
                                   class="table table-sm table-bordered w-100 text-center">
                                <thead class="  table-info th-sti">
                                    <tr class="table-border-bottom">
                                        <th>Customer</th>
                                        <th>PO No</th>
                                        <th>Bal Disp Qnty</th>
                                        <th>Disp Qnty Planned</th>
                                        <th>Disp Qnty Finalized</th>
                                        <th width="5%">
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- -------------  -->
                                </tbody>
                            </table>
                            <div class="mt-2 text-muted small">
                                In the event the the Quantity on Hand available to Dispatch is not sufficient to meet the entire Balance Quantity to Dispatch,
                                to redistribute Dispatch Quantity across Customers or across POs for the same Customer, first reduce in one Line Item and then
                                increase in the other line item. If reverse is done, error message will be shown
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Modal -->

    </div>
</div>

