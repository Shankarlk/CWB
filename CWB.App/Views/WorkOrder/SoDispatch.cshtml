<template id="P12GridRow">
    <tr>
        <th>{customer}</th>
        <th>{poNumber}</th>
        <th>{qntyOnHand}</th>
        <th>{finalDispQnty}</th>
        <td>
            <div class="dropdown float-center">
                <a href="#"
                   class="dropdown-toggle arrow-none card-drop"
                   data-bs-toggle="dropdown"
                   aria-expanded="false">
                    <i class="mdi mdi-dots-vertical"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-end">
                    <a href="javascript:void(0);"  data-partn="{partNo}" data-partdesc="{partDesc}" data-pono="{poNumber}"
                       data-customer="{customer}"  data-baldispqnty="{qntyOnHand}" data-soid="{salesOrderId}" data-findisqnty="{finalDispQnty}"
                       class="dropdown-item" onclick="EditP12(this)">Edit</a>
                </div>
            </div>
        </td>
    </tr>
</template>
