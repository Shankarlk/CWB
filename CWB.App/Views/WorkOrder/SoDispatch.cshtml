<template id="SOGridRow">
    <tr data-so-id="{salesOrderId}"  data-soallocid="{sO_Alloc_List_Id}">
        <th>
            <input class="form-check-input SOgridChks" type="checkbox" title=""
                   data-plugin="tippy" data-tippy-placement="top" placeholder="" data-findisqnty="{final_Dispatch_Qnty}">
        </th>
        <th>{soNumber}</th>
        <th>{customer}</th>
        <th>{poNumber}</th>
        <th>{partNo} / {partDesc}</th>
        <th>{requiredQuantity}</th>
        <th>{balanceSOQty}</th>
        <th>{qntyOnHand}</th>

        <th class="suggested-qnty-value">{suggestedDispQnty}</th>
        <th>{final_Dispatch_Qnty}</th>
        <th>{requiredByDateStr}</th>
        <th hidden>{dispatchId}</th>
        <th hidden>{invoiceNo}</th>
        <th hidden>{invoiceDate}</th>
        <th hidden>{dispatchDetail}</th>
        <th hidden>{partId}</th>
        <td>
            <div class="dropdown float-center">
                <a href="#"
                   class="dropdown-toggle arrow-none card-drop"
                   data-bs-toggle="dropdown"
                   aria-expanded="false">
                    <i class="mdi mdi-dots-vertical"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-end">
                    <!-- item-->
                    <a href="javascript:void(0);"
                       class="dropdown-item"
                       data-bs-toggle="modal" data-partn="{partNo}" data-partdesc="{partDesc}" data-pono="{poNumber}" data-suggested="{suggestedDispQnty}" data-soallocid="{sO_Alloc_List_Id}"
                       data-customer="{customer}" data-baldispqnty="{balanceSOQty}" data-soid="{salesOrderId}" data-findisqnty="{final_Dispatch_Qnty}" data-qoh="{qntyOnHand}"
                       data-bs-target="#popup12">Set Dispatch Qnty</a>
                    <a href="javascript:void(0);"
                       class="dropdown-item remove-suggested-qnty"
                       data-partn="{partNo}"
                       data-partdesc="{partDesc}"
                       data-soid="{salesOrderId}"
                       data-soallocid="{sO_Alloc_List_Id}"
                       data-findisqnty="{final_Dispatch_Qnty}"
                       data-sonumber="{soNumber}">
                        Remove Suggested Qnty
                    </a>

                    <!-- Remove Final Dispatch Quantity -->
                    <a href="javascript:void(0);"
                       class="dropdown-item remove-final-disp-qnty"
                       data-partn="{partNo}"
                       data-partdesc="{partDesc}"
                       data-soid="{salesOrderId}"
                       data-soallocid="{sO_Alloc_List_Id}"
                       data-findisqnty="{final_Dispatch_Qnty}"
                       data-sonumber="{soNumber}">
                        Remove Final Disp Qnty
                    </a>

                </div>
            </div>
        </td>
    </tr>
</template>


