@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Material Inwarding";
}
<input value="B-BP" type="hidden" id="hdn-nav-menu" />
<div class="content">
    <div class="row" id="myRadioGroup">
        <div class="col-xl-12 col-md-12 col-sm-12 col-xs-12">
            <!-- ================= -->
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12">
                            <h3 style="padding: 10px;">Inward Inspection</h3>
                        </div>
                        <!-- =============================  -->
                        <div class="col-md-12">
                            <hr class="mt-2">
                            <!-- ================================  -->
                            <div class="row">
                                <!-- ======================== -->
                                <!-- ======================== -->
                                <div class="col-md-2 mb-2">
                                    <label class="form-label">PO No</label>
                                    <input class="form-control form-control-sm w-100" type="text" title=""
                                           data-plugin="tippy" data-tippy-placement="top" placeholder=""
                                           id="searchPoNo">
                                </div>
                                <div class="col-md-2 mb-2">
                                    <label class="form-label">Supplier</label>
                                    <select class="form-select form-select-sm" aria-label="form-select-sm"
                                            title="" data-plugin="tippy" data-tippy-placement="top" id="searchSupp">
                                        <option value="">==========</option>
                                    </select>
                                </div>
                                <div class="col-md-2 mb-2">
                                    <label class="form-label">Part No / Desc</label>
                                    <input class="form-control form-control-sm w-100" type="text" title=""
                                           data-plugin="tippy" data-tippy-placement="top" placeholder=""
                                           id="searchPartNo">
                                </div>
                                <div class="col-md-2 mb-2">
                                    <label class="form-label">Part Type</label>
                                    <select class="form-select form-select-sm" aria-label="form-select-sm"
                                            title="" data-plugin="tippy" data-tippy-placement="top" id="searchPartType">
                                        <option value="0">--Select</option>
                                        <option value="1">RawMaterial</option>
                                        <option value="2">BOF</option>
                                        <option value="3">Sub Con</option>
                                    </select>
                                </div>
                                <!-- ======================== -->
                                <!-- ======================== -->
                                <div class="col-md-12">
                                    <div class="row">
                                        <div class="table-responsive table-he-250">
                                            <table class="table table-sm table-bordered w-100 text-center" id="inspGrid">
                                                <thead class="  table-info th-sti">
                                                    <tr class="table-border-bottom">
                                                        <th>Inward Date</th>
                                                        <th>PO No </th>
                                                        <th>Supplier</th>
                                                        <th>Part No / Desc</th>
                                                        <th>Part Type</th>
                                                        <th>Qnty</th>
                                                        <th>Units</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 " hidden>
                                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal"
                                            data-bs-target="#popupInspect6">
                                        Popup 6
                                    </button>
                                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal"
                                            data-bs-target="#popup7">
                                        Popup 7
                                    </button>
                                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal"
                                            data-bs-target="#popup8">
                                        Popup 8
                                    </button>
                                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal"
                                            data-bs-target="#popup9">
                                        Popup 9
                                    </button>
                                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal"
                                            data-bs-target="#ErrorMessage1">
                                        Error Message 1
                                    </button>
                                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal"
                                            data-bs-target="#ErrorMessage2">
                                        Error Message 2
                                    </button>
                                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal"
                                            data-bs-target="#ErrorMessage3">
                                        Error Message 3
                                    </button>
                                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal"
                                            data-bs-target="#ErrorMessage4">
                                        Error Message 4
                                    </button>
                                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal"
                                            data-bs-target="#ErrorMessage5">
                                        Error Message 5
                                    </button>
