<div class="modal fade" id="popup7" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="staticBackdropLabel" style="display: none;" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border: 4px solid #32AADD;">
            <div class="modal-header">
                <h4 class="modal-title" id="mySmallModalLabel">
                    Non Conformance Data Entry <br>
                    Part No / Desc : <span id="P7PartNoSpan"></span> from <span id="P7SuppSpan"></span>  <span id="P7FinOrInSpan"></span> <br>
                    <span id="P7RoutingDiv" hidden=""> Routing : <span id="P7RoutingSpan"></span> Opr No : <span id="P7OprNoSpan"></span></span>
                </h4>
                <button type="button" class="btn-close" id="P7BtnClose"></button>
