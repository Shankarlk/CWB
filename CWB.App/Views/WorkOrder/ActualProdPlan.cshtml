<style>
    .table-bordered > :not(caption) > * > * {
        border-color: #ced4da;
    }

    #simulationBody .bg-success {
        border: none !important;
    }
</style>
<div class="content">
    <div class="card-body">

        <!-- Page Title -->
        <div class="d-flex justify-content-between align-items-center mb-3">
           <h4 class="mb-0 fw-bold">Actual Production Plan Dashboard</h4>


        </div>

        <!-- Filters -->
        <div class="row mb-3">
            <!-- Search Filters -->
            <div class="row mb-3">


                <div class="col-md-2">
                    <label class="form-label fw-bold">View</label>

                    <select id="ddlView" class="form-select form-select-sm">
                        <option value="Machine">Machine View</option>
                        <option value="Part">Part View</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Display</label>

                    <select id="ddlDisplay" class="form-select form-select-sm">
                        <option value="Hour">Hour-wise</option>
                        <option value="Shift">Shift-wise</option>
                        <option value="Day">Day-wise</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Part No</label>
                    <input type="text" id="txtPartNo" class="form-control form-control-sm"
                           placeholder="Search Part No">
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Machine</label>
                    <input type="text" id="txtMachine" class="form-control form-control-sm"
                           placeholder="Search Machine">
                </div>

                <div>
                    <label class="form-label fw-bold" style="visibility:hidden;">Machine</label>
                </div>



                <div class="row mb-2">
                    <div class="col-12">
                        <div id="legendBar" class="d-flex flex-wrap align-items-center gap-4 border rounded p-2 px-3">

                            <!-- PART VIEW LEGEND -->
                            <div id="legendPartView" class="d-none flex-wrap align-items-center gap-4">
                                <div class="d-flex align-items-center">
                                    <span class="legend-swatch me-2" style="background:#7092BE;"></span>
                                    <span>Frozen Production Plan (Inhouse)</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="legend-swatch me-2" style="background:#0A58CA;"></span>
                                    <span>Actual Production (Inhouse)</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="legend-swatch me-2" style="background:#8B5FBF;"></span>
                                    <span>Frozen Production Plan (Subcon)</span>
                                </div>


                                <div class="d-flex align-items-center">
                                    <span class="legend-swatch me-2" style="background:#000000;"></span>
                                    <span>So Completion Date</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="legend-swatch me-2" style="background:#D6246E;"></span>
                                    <span>Matl Plan Receipt Date</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="legend-swatch me-2" style="background:#00E5FF;"></span>
                                    <span>Matl Act. Receipt Date</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="legend-swatch me-2" style="background:#00FF00;"></span>
                                    <span>SO Act. Completion Date</span>
                                </div>
                            </div>

                            <!-- MACHINE VIEW LEGEND -->

                            <div id="legendMachineView" class="d-none flex-wrap align-items-center gap-4">
                                <div class="d-flex align-items-center">
                                    <span class="legend-swatch me-2" style="background:#7092BE;"></span>
                                    <span>Frozen Production Plan (Inhouse)</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="legend-swatch me-2" style="background:#0A58CA;"></span>
                                    <span>Actual Production (Inhouse)</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="legend-swatch me-2" style="background: #EDE379; "></span>
                                    <span>Non-Plan Work (Frozen)</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="legend-swatch me-2" style="background: #C98404;"></span>
                                    <span>Actual NP Work</span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="timeline-wrapper">
                    <button id="btnPrev" class="timeline-arrow left">
                        <i class="fa fa-chevron-left"></i>
                    </button>

                    <div class="table-responsive" id="timelineContainer" style="max-height:650px; overflow:auto;">

                        <table class="table table-bordered text-center align-middle mb-0">

                            <thead>
                                <tr id="dateHeader"></tr>
                                <tr id="shiftHeader"></tr>
                                <tr id="hourHeader"></tr>
                            </thead>

                            <tbody id="simulationBody"></tbody>

                        </table>

                    </div>

                    <button id="btnNext" class="timeline-arrow right">
                        <i class="fa fa-chevron-right"></i>
                    </button>

                </div>

                <!-- Legend -->

                <div class="row mt-4">

                    <!-- Left Side -->
                    <div class="col-md-8">



                        <div>VMC1 = Critical Routing Step (Operation)</div>

                        <div>VMC1 * = Critical Routing Step (Operation) + Critical Setup</div>

                        <div>Pride * = Critical Setup</div>

                        <br>

                        <div>Part Bookout Summary can be provided below</div>

                    </div>




                </div>

            </div>
        </div>
    </div>

</div>
</div>

<template id="partSimulationRow">

    <tr>

        <td class="part-no-cell" data-tooltip="{partTooltip}" style="position: sticky; left: 0px; z-index: 95; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 160px; background:{partNoColor};">{partNo}</td>
        <td style="position:sticky; left:160px; background:#f8f9fa; z-index:94;">{urgent}</td>

        <td colspan="{totalHours}" class="position-relative p-0" style="border: 0.5px solid #ced4da;">

            <div class="timeline-grid" style="height:{rowHeight}px;width:{totalWidth}px;position:relative;">

                {operations}

                {soMarker}

                

            </div>

        </td>

    </tr>

</template>
<template id="machineSimulationRow">

    <tr>

        <td>{machineNo}</td>



        <td colspan="{totalHours}" class="position-relative p-0" style="border: 0.5px solid #ced4da;">

            <div class="timeline-grid"
                 style="height:{rowHeight}px;width:{totalWidth}px;position:relative;">

                {operations}

            </div>

        </td>

    </tr>

</template>
<template id="machineOperationTemplate">

    <div class="operation-bar"
         data-bartype="{barType}"
         style="
        position:absolute;
        left:{left}px;
        top:{top}px;
        width:{width}px;
        height:24px;
        background:{color};
        color:#fff;
        line-height:24px;
        text-align:center;
        border-radius:4px;">

        {partNum} - {operationName}

        <div class="operation-tooltip tooltip-inhouse">
            <b> M/c Bar</b><br>
            <span class="customer-line"><b>Part Sold to Customer:</b> {partSoldToCustomer}<br></span>
            <b>Shop / Machine:</b> <span class="tooltip-value">{shopMachine}</span><br>
            <b>Part No / Desc:</b> <span class="tooltip-value">{partNoDesc}</span><br>
            <b>Routing No / Opr No:</b> <span class="tooltip-value">{routingOprNo}</span><br>
            <b>WO No:</b> <span class="tooltip-value">{woNo}</span><br>
            <b>Batch Qnty:</b> <span class="tooltip-value">{batchQnty}</span><br>
            <b>Start Date / Time:</b> <span class="tooltip-value">{startDateTime}</span><br>
            <b>End Date / Time:</b> <span class="tooltip-value">{endDateTime}</span><br>
            <b>Duration (Hrs):</b> <span class="tooltip-value">{durationHours}</span><br>
            <b>Floor to Floor Time (min):</b> <span class="tooltip-value">{floorToFloorTime}</span><br>
            <b>Setup Time (min):</b> <span class="tooltip-value">{setupTime}</span><br>
        </div>

        <div class="operation-tooltip tooltip-actual">
            @*<b>Tool Tip Content for M/c Bar from Setup / Bookout data</b><br>*@
            <u>Actual Data</u><br>
            <b>Part Sold to Customer:</b> <span class="tooltip-value">{partSoldToCustomer}</span><br>
            <b>Shop / Machine:</b> <span class="tooltip-value">{shopMachine}</span><br>
            <b>Part No / Desc:</b> <span class="tooltip-value">{partNoDesc}</span><br>
            <b>Routing No / Opr No:</b> <span class="tooltip-value">{routingOprNo}</span><br>
            <b>WO No:</b> <span class="tooltip-value">{woNo}</span><br>
            <b>Booked out Qnty:</b> <span class="tooltip-value">{bookedOutQnty}</span><br>
            <b>NC Qnty:</b> <span class="tooltip-value">{ncQnty}</span><br>
            <b>Act Start Date / Time:</b> <span class="tooltip-value">{startDateTime}</span><br>
            <b>Act Setup Time (min):</b> <span class="tooltip-value">{actSetupMinutes}</span><br>
            <b>Act End Date / Time:</b> <span class="tooltip-value">{endDateTime}</span><br>
            <b>Act Duration (Hrs):</b> <span class="tooltip-value">{durationHours}</span><br>
            <b>Act Floor to Floor Time (min):</b> <span class="tooltip-value">{actFloorToFloor}</span><br>
        </div>

        <div class="operation-tooltip tooltip-nonplan">
            <u>Non Plan Work Details</u><br>
            <b>Shop / Machine:</b> {shopMachine}<br>
            <b>Start Date / Time:</b> {startDateTime}<br>
            <b>End Date / Time:</b> {endDateTime}<br>
            <b>Duration (Hrs):</b> {durationHours}<br>
            <b>Initiated by:</b> {initiatedBy}<br>
        </div>

        <div class="operation-tooltip tooltip-actualnonplan">
            @*<b>Tool Tip Content for Non Plan Work</b><br>*@
            <u>Non Plan Work Details (Actual)</u><br>
            <b>Shop / Machine:</b> <span class="tooltip-value">{shopMachine}</span><br>
            <b>Act Start Date / Time:</b> <span class="tooltip-value">{startDateTime}</span><br>
            <b>Act End Date / Time:</b> <span class="tooltip-value">{endDateTime}</span><br>
            <b>Act Duration (Hrs):</b> <span class="tooltip-value">{durationHours}</span><br>
            <b>Updated by:</b> <span class="tooltip-value">{initiatedBy}</span><br>
        </div>
    </div>

</template>
