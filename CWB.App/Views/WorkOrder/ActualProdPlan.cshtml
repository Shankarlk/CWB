    .part-view #dateHeader th:nth-child(2) {
        border-right: 1px solid #ced4da !important;
    }

    .machine-view #simulationBody td:first-child {
        border-right: 1px solid #ced4da !important;
    }

    .part-view #simulationBody td:nth-child(2) {
        border-right: 1px solid #ced4da !important;
    }

    .table {
        border-collapse: separate;
        border-spacing: 0;
    }

    .timeline-grid {
        position: relative;
        background-color: white;
        background-image: repeating-linear-gradient( to right, rgba(0,0,0,.05) 0px, rgba(0,0,0,.05) 1px, transparent 1px, transparent 38px );
    }
</style>



<style>
    .operation-bar {
        cursor: pointer;
        position: absolute;
        z-index: 3;
    }

    .operation-tooltip {
        display: none !important;
        position: absolute;
        bottom: 110%;
        left: 50%;
        transform: translateX(-50%);
        min-width: 220px;
        background: #fff;
        color: #333;
        border: 1px solid #ccc;
        border-radius: 6px;
        padding: 10px;
        text-align: left;
        box-shadow: 0 4px 12px rgba(0,0,0,.2);
        z-index: 9999;
        white-space: nowrap;
    }

    .table {
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
    }
    /* Only show the matching tooltip type for each bar type */
    .operation-bar[data-bartype="Inhouse"]:hover .tooltip-inhouse {
        display: block;
    }

    .operation-bar[data-bartype="NonPlan"]:hover .tooltip-nonplan {
        display: block;
    }

    .operation-bar[data-bartype="Subcon"]:hover .tooltip-subcon {
        display: block;
    }

    /* No rule for [data-bartype="Temp"] — stays hidden always */

    .operation-tooltip::after {
        content: "";
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        border-width: 8px;
        border-style: solid;
        z-index: 500;
        border-color: #fff transparent transparent transparent;
    }

    .matl-receipt-marker {
        position: absolute;
        top: 4px;
        height: 45px;
        background: #D6246E;
        border: 2px solid #000;
        cursor: pointer;
        z-index: 6;
    }

    .tooltip-matlmarker {
        display: none;
        position: absolute;
        bottom: 15px;
        left: 50%;
        transform: translateX(-50%);
        width: 220px;
        padding: 10px;
        background: #fff;
        color: #333;
