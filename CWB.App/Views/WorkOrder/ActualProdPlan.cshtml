<style>
    #sharedTooltip {
        width: 600px;
        min-width: 600px;
        max-width: 600px;
    }

        #sharedTooltip .cmp-table {
            width: 100%;
            margin-top: 8px;
            table-layout: fixed;
            border-collapse: collapse;
        }

            #sharedTooltip .cmp-table td {
                white-space: nowrap; /* date and time stay on one line */
                vertical-align: top;
                padding: 2px 6px 2px 0;
                border: none !important;
                text-align: left;
            }
    .part-view .so-completion-marker {
        top: 6px;
        height: 26px;
    }

    .so-act-completion-marker {
        top: 36px !important;
        height: 24px !important;
        background: #00FF00 !important;
        border: 1px solid #000;
    }
    .matl-act-receipt-marker {
        position: absolute;
        top: 6px;
        height: 24px;  
        background: #00E5FF;
        border: 1px solid #000;
        cursor: pointer;
        z-index: 6;
    }
    .tooltip-value {
        margin-left: 4px;
    }

    .d-flex {
        display: flex !important;
    }

    .legend-swatch {
        display: inline-block;
        width: 18px;
        height: 14px;
        border-radius: 3px;
    }

    #dateHeader th {
        position: sticky;
        top: 0;
        background: #f5f6f7;
        z-index: 70;
        height: 28px;
        padding: 0;
        line-height: 28px;
        font-size: 0.85rem;
    }

    #shiftHeader th {
        position: sticky;
        background: #f5f6f7;
        z-index: 60;
        height: 28px;
        padding: 0;
        line-height: 28px;
        font-size: 0.85rem;
    }

    #hourHeader th {
        position: sticky;
        background: #f5f6f7;
        z-index: 50;
        font-size: 0.8rem;
        line-height: 20px;
    }

    .timeline-wrapper {
        position: relative;
    }

    /* Floating arrows */
    .timeline-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 44px;
        height: 44px;
        border: none;
        border-radius: 50%;
        background: #fff;
        color: #555;
        box-shadow: 0 2px 10px rgba(0,0,0,.25);
        z-index: 99999;
        display: none;
        transition: .25s;
    }

        .timeline-arrow:hover {
            background: #7092BE;
            color: #fff;
        }

        .timeline-arrow.left {
            left: 12px;
        }

        .timeline-arrow.right {
            right: 12px;
        }

    .so-completion-marker {
        position: absolute;
        top: 4px;
        width: 36px;
        height: 45px;
        background: #000;
        cursor: pointer;
        z-index: 6;
    }

    .tooltip-somarker {
        display: none;
        position: absolute;
        /* show above the marker */
        bottom: 15px;
        left: 50%;
        transform: translateX(-50%);
        width: 220px;
        padding: 10px;
        background: #fff;
        color: #333;
        border: 1px solid #ccc;
        border-radius: 4px;
        text-align: left;
        white-space: normal;
        box-shadow: 0 4px 12px rgba(0,0,0,.2);
        z-index: 999999;
    }

    .so-completion-marker:hover .tooltip-somarker {
        display: block !important;
    }



    /* Part View
    .part-view #dateHeader th:first-child,
    .part-view #simulationBody td:first-child {
        position: sticky;
        left: 0;
        min-width: 160px;
        background: #f8f9fa;
        z-index: 105;
    }

    .part-view #dateHeader th:nth-child(2),
    .part-view #simulationBody td:nth-child(2) {
        position: sticky;
        left: 160px;
        min-width: 80px;
        background: #f8f9fa;
        z-index: 106;
        border-left: 1px solid #ced4da !important;
    }*/

    /* Machine View */
