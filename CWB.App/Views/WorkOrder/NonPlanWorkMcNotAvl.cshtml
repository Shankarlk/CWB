                        </div>
                        <label class="form-label col-md-4 mb-2">Work Description * </label>
                        <div class="col-md-6 mb-2">
                            <textarea class="form-control" id="P81WorkDesc" placeholder="Enter Work Description" style="height: 64px;"></textarea>
                        </div>
                        <label class="form-label col-md-4 mb-2">Non Plan Work Type * </label>
                        <div class="col-md-6 mb-2">
                            <select class="form-select form-select-sm" aria-label="form-select-sm" id="P81NonPlanType"
                                    title="" data-plugin="tippy" data-tippy-placement="top">
                                <option value="">==========</option>
                            </select>
                        </div>
                        <label class="form-label col-md-4 mb-2">Required Start Date / Time * </label>
                        <div class="col-md-4 mb-2">
                            <input class="form-control" id="P81ReqStartDate" type="date">
                        </div>
                        <div class="col-md-4 mb-2">
                            <input class="form-control" id="P81ReqStartTime" type="time">
                        </div>
                        <label class="form-label col-md-4 mb-2">Required Duration * </label>
                        <div class="col-md-4 mb-2">
                            <input class="form-control" id="P81ReqDur" type="text" placeholder="00:00">
                        </div>
                        <div class="col-md-12 text-end mt-2 mb-2">
                            <button type="button" class="btn btn-primary btn-sm" id="P81Save1">Save</button>
                        </div>
                        <hr class="mt-1 mb-2" id="Div2Acthr">
                        <div id="Div2Act" class="row">
                            <label class="form-label col-md-4 mb-2">Actual Start Date / Time * </label>
                            <div class="col-md-4 mb-2">
                                <input class="form-control" id="P81ActDate1" type="date">
                            </div>
                            <div class="col-md-4 mb-2">
                                <input class="form-control" id="P81ActTime1" type="time">
                            </div>
                            <div class="col-md-12 text-end mt-2 mb-2">
