                <div class="modal-body">
                    <div class="row">
                        <label class="form-label col-md-4 mb-2">Machine Selection * </label>
                        <div class="col-md-3 mb-2">
                            <input class="form-control" id="P81MachinceSel1" placeholder="Shop" type="text" readonly>
                        </div>
                        <div class="col-md-3 mb-2">
