                                <input class="form-check-input mt-1" type="radio" title="" data-plugin="tippy"
                                       id="dailyDispatch" name="equalwo" value="1" data-tippy-placement="top">
                            </div>
                            <!-- ============================  -->
                            <div class="col-md-2">
