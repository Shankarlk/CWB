                                <option value="">==========</option>
                            </select>
                        </div>
                        <!-- ===============  -->
                        <div class="col-md-12 text-end">
                            <button class="btn btn-primary btn-sm" id="updateWO">Save WO</button>
                        </div>
                        <div class="col-md-12" id="SubConGridDiv">
                            <h6>SubCon Operations</h6>
                            <div class="col-md-8">
                                <div class="table-responsive table-he-330">
                                    <table id="subConGridP1" class="table table-sm table-bordered w-100 text-center">
                                        <thead class="  table-info th-sti">
                                            <tr class="table-border-bottom">
                                                <th>Supplier</th>
                                                <th>Qnty</th>
                                                <th>Starting Opr No</th>
                                                <th>Ending Opr No</th>
