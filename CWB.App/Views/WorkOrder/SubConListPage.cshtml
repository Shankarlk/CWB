<div class="modal fade" id="Popup24" data-bs-backdrop="static" data-bs-keyboard="false"
     tabindex="-1" aria-labelledby="staticBackdropLabel" style="display: none;" aria-hidden="true">
    <div class="modal-dialog modal-xl-custom">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="mySmallModalLabel">
                    List of Parts at SubCon : <span id="P24McName">xxxxx</span>
                </h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-2 mb-2">
                        <label class="form-label">Part No</label>
                        <input class="form-control form-control-sm" type="text" title=""
                               data-plugin="tippy" data-tippy-placement="top"
                               placeholder="Enter " id="P24SearchPartNo">
                    </div>
                    <div class="col-md-2 mb-2">
                        <label class="form-label">Part Desc</label>
                        <input class="form-control form-control-sm" type="text" title=""
                               data-plugin="tippy" data-tippy-placement="top"
                               placeholder="Enter " id="P24SearchPartDesc">
                    </div>
                    <div class="col-md-12 mb-4" id="P6partInspectPlanGridDiv">
                        <div class="col-md-12">
                            <div class="table-responsive table-he-330">
                                <table id="P24Grid"
                                       class="table table-sm table-bordered w-100 text-center">
                                    <thead class="  table-info th-sti">
                                        <tr class="table-border-bottom">
                                            <th>WO Ref</th>
                                            <th>Part No / Desc</th>
                                            <th>Routing / Opr-No</th>
                                            <th>WO Qnty</th>
                                            <th>Bal Qnty</th>
                                            <th>PS Disp Date</th>
                                            <th>PS Recpt Date </th>
                                            <th>CS Disp Date </th>
                                            <th>CS Recpt Date </th>
                                            <th>Act Disp Date </th>
                                            <th>Data Changed</th>
                                            <th>Hold</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- -------------  -->
                                        <!-- -------------  -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div>

<div class="modal fade" id="Popup25" data-bs-backdrop="static" data-bs-keyboard="false"
     tabindex="-1" aria-labelledby="staticBackdropLabel" style="display: none;" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border: 4px solid #5eafd2;">
            <div class="modal-header">
                <h5 class="modal-title" id="mySmallModalLabel">
                    SubCon : <span id="P25SubName">xxxxx</span> <br>
                    Part No / Desc : <span id="P25PartName">xxxxx / xxxxx</span>  <br>
                    Routing / Opr No : <span id="P25RoutName">xxxxx / xxxxx</span> <br>
                    <br>
                    Total Processing Qnty for Opr No : <span id="P25QntyName">xxxxx</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <label class="form-label col-md-4 mb-2"></label>
                    <label class="form-label col-md-4 mb-2 text-center">Plan / Previous </label>
                    <label class="form-label col-md-4 mb-2 text-center">New </label>
                    <label class="form-label col-md-4 mb-2">Dispatch Date (from us) </label>
                    <div class="col-md-4 mb-2">
                        <input class="form-control" id="P25DispPrev" type="text" readonly>
                    </div>
                    <div class="col-md-4 mb-2">
                        <input class="form-control" id="P25DispNew" type="date">
                    </div>
                    <label class="form-label col-md-4 mb-2">Receipt Date (from SubCon) </label>
                    <div class="col-md-4 mb-2">
                        <input class="form-control" id="P25RecptPrev" type="text" readonly>
                    </div>
                    <div class="col-md-4 mb-2">
                        <input class="form-control" id="P25RecptNew" type="date">
                        <input class="form-control" id="P25SubconId" type="text" hidden>
                    </div>
                    <div class="col-md-12 text-end mt-2 mb-2">
                        <button type="button" class="btn btn-primary btn-sm" id="P25Save">Save</button>
                    </div>
                </div>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div>

<div class="modal fade" id="ErrorMessage1" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="staticBackdropLabel" style="display: none;" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border: 4px solid #5eafd2;">
            <div class="modal-header">
                <h4 class="modal-title" id="mySmallModalLabel">Data is not saved</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <form id="frmAddUOM" onsubmit="return false;" novalidate="novalidate">
                        <div class="row">
                            <label class="form-label col-md-6 mb-2">

                                Save changes & Exit
                                <br>
                                <br>
                                <br>
                                Return to Popup to Edit
                                <br>
                                <br>
                                <br>
                                Exit without saving changes

                            </label>
                            <div class="col-md-6 text-center">
                                <input id="openfrom" type="text" hidden />
                                <button class="btn btn-sm btn-primary" id="ErBtn1">Save & Exit</button>
                                <br>
                                <button class="btn btn-sm mt-4 btn-primary" id="ErBtn2">Edit Entered Data</button>
                                <button class="btn btn-sm mt-4 btn-primary" id="ErBtn3">Exit without Saving Entered Data</button>
                            </div>
                        </div>
                    </form>
                    <!-- ========================= -->
                </div>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div>

<template id="P23GridRow">
