@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
    <style>
        .modal-stack-blur {
            filter: blur(5px);
            pointer-events: none;
            user-select: none;
        }
    </style>
<div class="container-fluid">

    <div class="row mb-4">
        <div class="col-md-12">
            <h3>Gro Stock Update</h3>
        </div>
    </div>
    @{
        List<CWB.App.Models.EmployeeMaster.Role_UI_ListVM> permissionResult = null;
        var permissionsJson = HttpContextAccessor.HttpContext.Session.GetString("Permissions");
        if (permissionsJson != null)
        {
            permissionResult = Newtonsoft.Json.JsonConvert.DeserializeObject<List<CWB.App.Models.EmployeeMaster.Role_UI_ListVM>>(permissionsJson);

        }
    }
    <div class="row">

        <!-- Parts with Stock -->
        <div class="col-lg-6">

            <div class="card">

                <div class="card-header text-center">
                    <h5>Part Nos with Stock</h5>
                </div>

                <div class="card-body">

                    <label>Gro Part No</label>

                    <input type="text"
                           id="txtWithStockSearch"
                           class="form-control"
                           placeholder="Search Part No / Description" />

                    <div class="table-responsive  mt-3">

                        <table class="table table-bordered table-hover"
                               id="tblWithStock">

                            <thead class="table-info">

                                <tr>
                                    <th>Gro Part No / Description</th>
                                    <th width="80">QOH</th>
                                    <th width="40"></th>
                                </tr>

                            </thead>

                            <tbody></tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

        <!-- Parts with Zero Stock -->

        <div class="col-lg-6">

            <div class="card">

                <div class="card-header text-center">
                    <h5>Part Nos with Zero Stock</h5>
                </div>

                <div class="card-body">

                    <label>Gro Part No</label>

                    <input type="text"
                           id="txtZeroStockSearch"
                           class="form-control"
                           placeholder="Search Part No / Description" />

                    <div class="table-responsive   mt-3">

                        <table class="table table-bordered table-hover"
                               id="tblZeroStock">

                            <thead class="table-info">

                                <tr>
                                    <th>Gro Part No / Description</th>
                                    <th width="40"></th>
                                </tr>

                            </thead>

                            <tbody></tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<div class="modal fade" id="updateStockModal" tabindex="-1" data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog modal-fullscreen modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header position-relative">

                <h5 class="modal-title position-absolute start-50 translate-middle-x">
                    Gro Part Stock Update
                </h5>

                <button type="button"
                        class="btn-close ms-auto"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body fs-4">

                <input type="hidden" id="hdnGroPartListId" />

                <div class="mx-auto" style="width:850px;">

                    <!-- Gro Part -->
                    <div class="mb-2">

                        <label class="form-label">Gro Part No</label>

                        <input type="text"
                               id="txtGroPartNo"
                               class="form-control"
                               style="width:300px;"
                               readonly />

                    </div>

                    <!-- Current Stock -->
                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div style="width:520px;">

                            Current Stock of
                            <b><span id="lblCurrentStockText">xxx</span></b>

                        </div>

                        <input type="text"
                               id="txtCurrentStock"
                               class="form-control text-end"
                               style="width:120px;"
                               readonly />

                    </div>

                    <!-- Qty -->
                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div style="width:520px;">

                            Qty to add to Stock
                            <span class="text-danger">*</span>

                        </div>

                        <input id="txtQtyToAdd"
                               class="form-control text-end"
                               style="width:120px;" />

                    </div>

                    <!-- Print -->
                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div style="width:520px;">

                            Sticker(s) printed. Please Stick
                            <br />
                            one MRP Label per Box / Packet

                        </div>

                        <button class="btn btn-primary"
                                id="btnPrintLabels"
                                style="width:120px;">

                            Print MRP Label

                        </button>

                    </div>

                    <!-- Labels Stuck -->
                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div style="width:520px;">

                            Confirm Labels are stuck are on Boxes / Packets

                        </div>

                        <button class="btn btn-primary"
                                id="btnLabelsStuck"
                                style="width:120px;">

                            Labels Stuck

                        </button>

                    </div>

                    <!-- Scan -->
                    <div class="text-center mb-2">

                        <button class="btn btn-primary px-5"
                                id="btnScanLabels">

                            Scan Labels

                        </button>

                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div style="width:520px;">

                            Last Scanned QR Code

                        </div>

                        <input type="text"
                               id="txtScannedQRCode"
                               class="form-control"
                               style="width:250px;"
                               placeholder="Waiting for scan..."
                              autocomplete="off" />

                    </div>
                    <!-- Boxes -->
                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div style="width:520px;">

                            Number of Boxes Scanned

                        </div>

                        <input type="text"
                               id="txtBoxesScanned"
                               class="form-control text-end"
                               style="width:120px;"
                               readonly />

                    </div>

                    <!-- Success Box -->

                    <div class="mx-auto mb-6 fs-4"
                         style="width:370px;
                    border:1px dashed #666;
                    border-radius:8px;
                    padding:2px;">

                        <table class="table table-borderless table-sm mb-3">

                            <tr>

                                <td>Qty added to Stock Successfully</td>

                                <td id="lblQtyAdded">xxx</td>

                            </tr>

                            <tr>

                                <td>Current Stock</td>

                                <td id="lblUpdatedStock">xxxxx</td>

                            </tr>

                        </table>

                        <div class="text-center">

                            <button class="btn btn-primary"
                                    id="btnSaveExitStock">

                                Save & Exit

                            </button>

                        </div>

                    </div>

                    <!-- Validation Box -->

                    

                </div>

            </div>

        </div>
    </div>
</div>
<div class="modal fade" id="deleteLabelsModal" tabindex="-1" data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Delete / Cancel Printed Labels
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <!-- Heading -->
                <div class="text-center fw-bold text-secondary mb-4">
                    Delete / Cancel <span id="lblPendingLabels">xx</span> Labels not scanned
                </div>

                <!-- Qty -->
                <div class="row mb-1 align-items-center">
                    <div class="col-md-7">
                        Qty to add to Stock Entered
                    </div>

                    <div class="col-md-2 text-end">
                        :
                    </div>

                    <div class="col-md-3">
                        <span id="lblQtyEntered">xx</span>
                    </div>
                </div>

                <!-- Stickers -->
                <div class="row mb-2 align-items-center">
                    <div class="col-md-7">
                        Number of Stickers Stuck on Box entered
                    </div>

                    <div class="col-md-2 text-end">
                        :
                    </div>

                    <div class="col-md-3">
                        <span id="lblStickerCount">xx</span>
                    </div>
                </div>

                <!-- Serial Numbers -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        Following Sl Nos are not Scanned
                    </div>

                    <div class="col-md-8">
                        <textarea class="form-control"
                                  rows="4"
                                  id="txtNotScanned"
                                  readonly></textarea>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div style="width:520px;">

                        Last Scanned QR Code

                    </div>

                    <input type="text"
                           id="txtReScannedQRCode"
                           class="form-control"
                           style="width:250px;"
                           placeholder="Waiting for scan..."
                           readonly />

                </div>
                <!-- Button 1 -->
                <div class="text-center mb-3">
                    <button class="btn btn-primary px-4"
                            id="btnRescan">
                       Re-Scan Sl Nos. not Scanned
                    </button>
                </div>

                <!-- Button 2 -->
                <div class="text-center mb-4">
                    <button class="btn btn-primary px-4"
                            id="btndeletelabel">
                        Delete Labels not Scanned
                    </button>
                </div>
                <div class="text-center mb-3">
                    <button class="btn btn-primary px-4"
                            id="btnConfirmDelete">
                        Confirm Deletion of Printed Labels not Scanned
                    </button>
                </div>
                <div class="text-center mb-3">
                    <button class="btn btn-primary px-4"
                            id="btnConfirmDestroy">
                        Confirm Printed Labels not scanned have been Destroyed
                    </button>
                </div>
                <!-- Save -->
                <div class="text-center">
                    <button class="btn btn-primary px-5"
                            id="btnSaveExit">
                        Save &amp; Exit
                    </button>
                </div>

            </div>

        </div>
    </div>
</div>
<div class="modal fade" id="printLabelModal" tabindex="-1" data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Print MRP Labels</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body"
                 style="max-height:70vh;overflow-y:auto;">

                <div id="printHelper">

                    <div class="row g-3"
                         id="qrContainer">
                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-primary"
                        id="btnPrint">
                    Print
                </button>

            </div>

        </div>
    </div>

</div>

<div class="modal fade"
     id="pendingLabelsModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title">
                    Pending Labels Found
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div id="pendingLabelsMessage"></div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="~/js/Gro/grostock.js"></script>
}
<template id="groPartWithStockRow">

    <tr>

        <td hidden>{gro_Part_List_ID}</td>

        <td>
            {gro_Part_No}
        </td>

        <td class="text-center">
            {qnty_on_Hand}
        </td>

        <td class="text-center">

            <div class="dropdown">

                <a href="#"
                   class="dropdown-toggle arrow-none card-drop"
                   data-bs-toggle="dropdown">
                    <i class="mdi mdi-dots-vertical"></i>
                </a>

                <div class="dropdown-menu dropdown-menu-end">

                    @if (permissionResult != null)
                    {
                        var pr = permissionResult
                            .FirstOrDefault(r => r.Menu3 == "Update Stock");

                        if (pr != null && pr.PermissionId >= 3)
                        {
                            <a href="javascript:void(0);"
                               class="dropdown-item"
                               onclick="LoadUpdateStock(this)"
                               data-bs-toggle="modal"
                               data-bs-target="#updateStockModal">
                                Update Stock
                            </a>
                        }

                    }
                    else
                    {
                        <a href="javascript:void(0);"
                           class="dropdown-item"
                           onclick="LoadUpdateStock(this)"
                           data-bs-toggle="modal"
                           data-bs-target="#updateStockModal">
                            Update Stock
                        </a>
                    }


                </div>

            </div>

        </td>

    </tr>

</template>
<template id="groPartWithoutStockRow">

    <tr>

        <td hidden>{gro_Part_List_ID}</td>

        <td>
            {gro_Part_No}
        </td>
        <td hidden>
            {qnty_on_Hand}
        </td>
        <td class="text-center">

            <div class="dropdown">

                <a href="#"
                   class="dropdown-toggle arrow-none card-drop"
                   data-bs-toggle="dropdown">
                    <i class="mdi mdi-dots-vertical"></i>
                </a>

                <div class="dropdown-menu dropdown-menu-end">

                    @if (permissionResult != null)
                    {
                        var pr = permissionResult
                            .FirstOrDefault(r => r.Menu3 == "Update Stock");

                        if (pr != null && pr.PermissionId >= 3)
                        {
                            <a href="javascript:void(0);"
                               class="dropdown-item"
                               onclick="LoadUpdateStock(this)"
                               data-bs-toggle="modal"
                               data-bs-target="#updateStockModal">
                                Update Stock
                            </a>
                        }

                    }
                    else
                    {
                        <a href="javascript:void(0);"
                           class="dropdown-item"
                           onclick="LoadUpdateStock(this)"
                           data-bs-toggle="modal"
                           data-bs-target="#updateStockModal">
                            Update Stock
                        </a>
                    }

                </div>

            </div>

        </td>

    </tr>

</template>
