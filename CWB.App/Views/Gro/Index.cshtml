@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<style>
    #editDispatchAddressModal
    {
        z-index: 1065 !important;
    }
</style>
<div class="content">
    <div class="card">
        <div class="card-body">
            <h4 class="pb-1 mt-1 mb-1">Gro Sales Data Management</h4>

            @{
                List<CWB.App.Models.EmployeeMaster.Role_UI_ListVM> permissionResult = null;
                var permissionsJson = HttpContextAccessor.HttpContext.Session.GetString("Permissions");
                if (permissionsJson != null)
                {
                    permissionResult = Newtonsoft.Json.JsonConvert.DeserializeObject<List<CWB.App.Models.EmployeeMaster.Role_UI_ListVM>>(permissionsJson);

                }
            }
            <!-- Upload Section -->
            <hr class="my-1" />
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h5>
                        Upload Gro Data from Excel File
                        <small>(Last Updated on  <span id="LastUpdatedDate">--</span>)</small>
                    </h5>
                </div>
                <div class="col-md-4 text-end">
                    <button class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#groUploadModal">
                        Upload
                    </button>
                </div>
            </div>
            <hr class="my-1" />

            <!-- Dispatch Qty -->

            <div class="row">
                <div class="col-md-9">
                    <h5>Number of Indent Line Items to be Dispatched</h5>

                    <div class="table-responsive">
                        <table class="table table-bordered text-center">
                            <thead>
                                <tr>
                                    <th>Ageing</th>
                                    <th>0</th>
                                    <th>1</th>
                                    <th>2</th>
                                    <th>3</th>
                                    <th>> 3</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Full Qty to be Dispatched</td>
                                    <td>xx</td>
                                    <td></td>
                                    <td>xx</td>
                                    <td></td>
                                    <td>xx</td>
                                    <td>xx</td>
                                </tr>
                                <tr>
                                    <td>Partial Qty Dispatched</td>
                                    <td></td>
                                    <td>xx</td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td>xx</td>
                                </tr>
                                <tr>
                                    <td>Qty not Dispatched</td>
                                    <td></td>
                                    <td>xx</td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td>xx</td>
                                </tr>
                                <tr>
                                    <td>Total</td>
                                    <td>xx</td>
                                    <td>xx</td>
                                    <td>xx</td>
                                    <td></td>
                                    <td>xx</td>
                                    <td>xx</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="col-md-3 text-end align-self-center">

                    <button class="btn btn-primary gro-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#dispatchPopup">
                        Dispatch Qnty
                    </button>
                </div>
            </div>
            <hr class="my-1" />

            <!-- Dispatch Details -->

            <div class="row align-items-center">
                <div class="col-md-9">
                    <h5>
                        Number of Dispatches waiting for Courier Dispatch Details
                        Update : xx
                    </h5>
                </div>

                <div class="col-md-3 text-end">
                    <button class="btn btn-primary" data-bs-toggle="modal"
                            data-bs-target="#dispatchDetailsDataUpdatePopup">
                        Dispatch Details
                    </button>
                </div>
            </div>
            <hr class="my-1" />

            <!-- Delivery Details -->

            <div class="row">
                <div class="col-md-9">

                    <h5>
                        Number of Indent waiting for Delivery Date Update : xx
                    </h5>

                    <div class="table-responsive">
                        <table class="table table-bordered text-center">
                            <thead>
                                <tr>
                                    <th>Ageing</th>
                                    <th>0-2</th>
                                    <th>3-5</th>
                                    <th>5-7</th>
                                    <th>8-10</th>
                                    <th>>11</th>
                                    <th>Total</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr>
                                    <td>Full Qty to be Dispatched</td>
                                    <td>xx</td>
                                    <td></td>
                                    <td>xx</td>
                                    <td></td>
                                    <td>xx</td>
                                    <td>xx</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-2">
                        Total No of Parts : xx
                    </div>

                </div>

                <div class="col-md-3 text-end align-self-center">
                    <button class="btn btn-primary" data-bs-toggle="modal"
                            data-bs-target="#deliverydataupdatemodal">
                        Delivery Details
                    </button>
                </div>
            </div>
            <hr class="my-1" />

            <!-- Delivery Complete -->

            <div class="row align-items-center">
                <div class="col-md-9">
                    <h5>View Dispatched / Delivered Indent Data</h5>
                </div>

                <div class="col-md-3 text-end">
                    <button class="btn btn-primary" data-bs-toggle="modal"
                            data-bs-target="#deliveryCompletePopup">
                        Delivery Complete
                    </button>
                </div>
            </div>
            <hr class="my-1" />

            <!-- MIS -->

            <div class="row align-items-center">
                <div class="col-md-9">
                    <h5>View Reports / Analysis</h5>
                </div>

                <div class="col-md-3 text-end">
                    <button class="btn btn-primary gro-btn">
                        MIS
                    </button>
                </div>
            </div>
            <hr class="my-1" />

            <!-- Setup -->
            @if (permissionResult != null)
            {
                @if (permissionResult.Any(r => r.Menu3 == "Gro Sales Setup"))
                {
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h5>Setup</h5>
                        </div>

                        <div class="col-md-3 text-end">
                            <button class="btn btn-primary gro-btn"
                                    onclick="location.href='@Url.Action("GroSetup", "Gro")'">
                                Setup
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="row align-items-center">
                    <div class="col-md-9">
                        <h5>Setup</h5>
                    </div>

                    <div class="col-md-3 text-end">
                        <button class="btn btn-primary gro-btn"
                                onclick="location.href='@Url.Action("GroSetup", "Gro")'">
                            Setup
                        </button>
                    </div>
                </div>

            }




        </div>
    </div>
</div>
@section scripts {
    <script src="~/js/gro/grosales.js"></script>


}

@* Popup 8  gro upload *@
<div class="modal fade"
     id="groUploadModal"
     tabindex="-1"
     aria-labelledby="groUploadModalLabel"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header border-0 pb-0">
                <h4 class="modal-title" id="groUploadModalLabel">
                    Gro - Data Upload from Excel
                </h4>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">

                <hr class="my-1" />

                <div class="row mt-4">

                    <!-- Left Side -->
                    <div class="col-md-4 text-center">

                        <div class="mb-3">

                            <input type="file"
                                   id="groExcelFile"
                                   accept=".xls,.xlsx"
                                   style="display:none;"
                                   onchange="displayFileName()" />

                            <button type="button"
                                    class="btn btn-secondary"
                                    onclick="$('#groExcelFile').click();">

                                Select File

                            </button>

                        </div>

                        <div class="input-group mb-4">

                            <input type="text"
                                   id="selectedFileName"
                                   class="form-control"
                                   readonly />

                        </div>

                        <button class="btn btn-primary"
                                onclick="startGroUpload()">

                            Start Upload

                        </button>

                        <br />

                        <button class="btn btn-outline-danger mt-5" style="display:none;">
                            Abort Upload
                        </button>

                    </div>

                    <!-- Right Side -->
                    <div class="col-md-8">

                        <h5 class="mb-4">
                            Summary of Uploaded Data
                        </h5>

                        <table class="table table-borderless table-sm w-auto">
                            <tr>
                                <td>Number of Indents</td>
                                <td>:</td>
                                <td id="IndentCount">0</td>
                            </tr>

                            <tr>
                                <td>Sum of Ordered Products</td>
                                <td>:</td>
                                <td id="ProductCount">0</td>
                            </tr>
                        </table>

                        <div class="mt-5">

                            <h6>
                                Select if uploaded Entries need to be deleted
                            </h6>



                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
