@* popup 1 Dispatch selection popup *@
<div class="modal fade" id="dispatchPopup" tabindex="-1" data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog modal-full-width">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">
                    Gro - Dispatch Selection
                </h4>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                <div class="mb-2" id="divAgeingInfo" style="display:none;">
                    <strong>Ageing :</strong>
                    <span id="lblAgeing"></span>
                </div>
                <!-- Filters -->
                <div class="row mb-3">

                    <div class="col-md-3">
                        <label>Indent</label>
                        <input type="text"
                               class="form-control"
                               id="txtIndentSearch"
                               placeholder="Search Indent">
                    </div>

                    <div class="col-md-3">
                        <label>From Date</label>
                        <input id="txtFromDate" type="date" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>To Date</label>
                        <input id="txtToDate" type="date" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>Dispatch Status</label>
                        <select class="form-select" id="ddlDispatchStatus">
                            <option value="All">All</option>
                            <option value="No Dispatch">No Dispatch</option>
                            <option value="Partial Dispatch">Partial Dispatch</option>
                        </select>
                    </div>
                   

                </div>
                <div class="row mb-3">
                    <div class="col-md-3">
                        <button type="button" id="btnClearFilter" class="btn btn-secondary w-100">
                            Clear
                        </button>
                    </div>
                </div>
                    <!-- Select All -->
                    <div class="form-check mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               id="chkAll">

                        <label class="form-check-label"
                               for="chkAll">
                            Select All
                        </label>
                    </div>

                    <!-- Grid -->
                    <div class="table-responsive  table-he-250">
                        <table class="table table-sm table-bordered w-100 text-center" id="Dispatchselectiontable">
                            <thead class=" table-info th-sti">
                                <tr class="table-border-bottom">
                                    <th></th>
                                    <th>Indent Date</th>
                                    <th>Indent No</th>
                                    <th>Customer</th>
                                    <th>Product</th>
                                    <th>Order Qty</th>
                                    <th>Bal Disp Qty</th>
                                    <th>Qnty Avl</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody>
                            </tbody>

                        </table>
                    </div>

                </div>

                <div class="modal-footer">
                    <button id="updatedispatchqnty" class="btn btn-primary" disabled
                            data-bs-toggle="modal"
                            data-bs-target="#dispatchQtyModal">
                        Update Dispatch Qty
                    </button>


                </div>

            </div>
    </div>
</div>
@* popup 2 show Dispatch Details/gro data line item popup *@
<div class="modal fade" id="dispatchDetailsPopup" tabindex="-1" data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog modal-full-width">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">
                    Gro - Line Item Details
                </h4>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <div class="row mb-2">
                    <div class="col-md-2"><strong>Indent Date</strong></div>
                    <div class="col-md-10">:<span id="lblIndentDate"></span></div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-2"><strong>Indent No</strong></div>
                    <div class="col-md-10">: <span id="lblIndentNo"></span></div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-2"><strong>Customer</strong></div>
