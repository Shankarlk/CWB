<!-- Edit Gro Part Popup2 -->
<div class="modal fade"
     id="editGroPartPopup"
     tabindex="-1"
     aria-labelledby="editGroPartPopupLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="editGroPartPopupLabel">
                    Gro Part Edit
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="hdnGroPartId" />

                <!-- Gro Part No -->
                <div class="row mb-3">
                    <label class="col-md-3 col-form-label">
                        Gro Part No <span class="text-danger">*</span>
                    </label>

                    <div class="col-md-6">
                        <input type="text"
                               class="form-control"
                               id="txtGroPartNo" />
                    </div>
                </div>

                <!-- MRP -->
                <div class="row mb-3">
                    <label class="col-md-3 col-form-label">
                        Gro MRP (Rs) <span class="text-danger">*</span>
                    </label>

                    <div class="col-md-4">
                        <input type="number"
                               class="form-control"
                               id="txtMrp" />
                    </div>
                </div>

                <!-- Our Price -->
                <div class="row mb-3">
                    <label class="col-md-3 col-form-label">
                        Our Price (Rs) <span class="text-danger">*</span>
                    </label>

                    <div class="col-md-4">
                        <input type="number"
                               class="form-control"
                               id="txtOurPrice" />
                    </div>
                </div>

                <!-- Our Part -->
                <div class="row mb-3" style="display:none;">
                    <label class="col-md-3 col-form-label">
                        Our Part No
                    </label>

                    <div class="col-md-6">

                        <div class="input-group">

                            <input type="text"
                                   class="form-control"
                                   id="txtOurPartNo"
                                   readonly />

                            <button class="btn btn-outline-secondary"
                                    type="button"
                                    id="btnSearchPart">
                                <i class="mdi mdi-magnify"></i>
                            </button>

                        </div>

                    </div>
                </div>

                <!-- HSN -->
                <div class="row mb-3">
                    <label class="col-md-3 col-form-label">
                        HSN Code <span class="text-danger">*</span>
                    </label>

                    <div class="col-md-6">
                        <input type="text"
                               class="form-control"
                               id="txtHSNCode" />
                    </div>
                </div>

                <!-- GST -->
                <div class="row mb-3">
                    <label class="col-md-3 col-form-label">
                        GST Rate % <span class="text-danger">*</span>
                    </label>

                    <div class="col-md-4">
                        <input type="number"
                               class="form-control"
                               id="txtGSTRate" />
                    </div>
                </div>

                <!-- Status -->
                <div class="row mb-3" style="display:none;">
                    <label class="col-md-3 col-form-label">
                        Part Status
                    </label>

                    <div class="col-md-4">
                        <select class="form-select"
                                id="ddlGroPartStatus">
                            <option value="1">Active</option>
                            <option value="2">Obsolete</option>
                        </select>
                    </div>
                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-primary"
                        id="btnSaveGroPart"
                        onclick="saveGroPart()">
                    Save
                </button>

            </div>

        </div>

    </div>

</div>
<!-- Courier List Popup3 -->
<div class="modal fade"
     id="courierListModal"
     tabindex="-1"
     aria-labelledby="courierListModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="courierListModalLabel">
                    Courier List
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <div class="table-responsive table-he-350">

                    <table class="table table-bordered table-sm text-center w-100" id="CourierGrid">

