<!-- Edit Courier Popup4     -->
<div class="modal fade"
     id="editCourierPopup"
     tabindex="-1"
     aria-labelledby="editCourierPopupLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="editCourierPopupLabel">
                    Edit Courier
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="hdnCourierId" />
                <div class="row mb-3">
                    <label class="col-md-3 col-form-label">
                        Courier
                    </label>

                    <div class="col-md-6">
                        <input type="text"
                               class="form-control"
                               id="txtCourierName" />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-md-3 col-form-label">
                        Contact Person
                    </label>

                    <div class="col-md-6">
                        <input type="text"
                               class="form-control"
                               id="txtCourierContactPerson" />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-md-3 col-form-label">
                        Contact No
                    </label>

                    <div class="col-md-6">
                        <input type="text"
                               class="form-control"
                               id="txtCourierContactNo" />
                    </div>
                </div>

            </div>

            <div class="modal-footer justify-content-end">

                <button class="btn btn-primary"
                        id="btnSaveCourier"
                        onclick="saveCourier()">
                    Save
                </button>

            </div>

        </div>

    </div>

</div>
@* popup5 th dc popup *@
<div class="modal fade"
     id="groInvDcControlModal"
     tabindex="-1"
     aria-labelledby="groInvDcControlModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="groInvDcControlModalLabel">
                    Invoice / Delivery Challan Control
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="hdnInvDcControlId" value="0" />

                <div class="row mb-3">
                    <label class="col-md-5 col-form-label">
                        Enable Delivery Challan Printing
                    </label>

                    <div class="col-md-2">
                        <input type="checkbox"
                               class="form-check-input mt-2"
                               id="chkDCEnable" />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-md-5 col-form-label">
                        Enable Invoice Printing
                    </label>

                    <div class="col-md-2">
                        <input type="checkbox"
                               class="form-check-input mt-2"
                               id="chkInvPrintEnable" />
                    </div>
                </div>

                <div class="row mb-4">
                    <label class="col-md-5 col-form-label">
                        Enable Invoice Push to Tally
                    </label>

                    <div class="col-md-2">
                        <input type="checkbox"
                               class="form-check-input mt-2"
                               id="chkInvPushEnable" />
                    </div>
                </div>

                <hr />

                <div class="row mb-3">
                    <label class="col-md-5 col-form-label">
                        Current Last DC Serial No Used
                    </label>

                    <div class="col-md-3">
                        <input type="text"
                               class="form-control"
                               id="txtCurrentDCNo"
                               readonly />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-md-5 col-form-label">
                        Set DC Serial No To
                    </label>

                    <div class="col-md-3">
                        <input type="number"
                               class="form-control"
                               id="txtNewDCNo" />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-md-5 col-form-label">
                        Current Last Invoice Serial No Used
                    </label>

                    <div class="col-md-3">
                        <input type="text"
                               class="form-control"
                               id="txtCurrentInvNo"
                               readonly />
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-md-5 col-form-label">
                        Set Invoice Serial No To
                    </label>

                    <div class="col-md-3">
                        <input type="number"
                               class="form-control"
                               id="txtNewInvNo" />
                    </div>
                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-primary"
                        onclick="saveInvDcControl()">
                    Save
                </button>

            </div>

        </div>

    </div>

</div>
<template id="groPartListRow">

    <tr>

        <td>{gro_Part_No}</td>

        <td> </td>

        <td> </td>

        <td>{mrp}</td>
        <td>{gstRate}</td>
        <td>{hsnCode}</td>

        <td>{statusText}</td>

        <td class="text-center">

            <div class="dropdown">

                <a href="#"
                   class="dropdown-toggle arrow-none"
                   data-bs-toggle="dropdown">

                    <i class="mdi mdi-dots-vertical"></i>

                </a>

                <div class="dropdown-menu dropdown-menu-end">

                    <a href="javascript:void(0);"
                       class="dropdown-item"
                       data-bs-toggle="modal"
                       data-bs-target="#editGroPartPopup"
                       onclick="editGroPart(this)"
                       data-id="{gro_Part_ListId}"
                       data-gropart="{gro_Part_No}"
                       data-ourpart="{our_Part_No}"
                       data-description="{our_Part_Description}"
                       data-mrp="{mrp}"
                       data-ourprice="{ourPrice}"
                       data-gstrate="{gstRate}"
                       data-hsn="{hsnCode}"
                       data-status="{part_Status}">
                        Edit
                    </a>

                </div>

            </div>

        </td>

    </tr>

</template>
<template id="courierRow">

    <tr>

        <td>{courier_Name}</td>
        <td>{contact_Person}</td>
        <td>{contact_Phone}</td>

        <td class="text-center">

            <div class="dropdown">

                <a href="#"
                   class="dropdown-toggle arrow-none"
                   data-bs-toggle="dropdown">
                    <i class="mdi mdi-dots-vertical"></i>
                </a>

                <div class="dropdown-menu dropdown-menu-end">

                    <a href="javascript:void(0);"
                       class="dropdown-item"
                       data-bs-toggle="modal"
                       data-bs-target="#editCourierPopup"
                       onclick="editCourier(this)"
                       data-id="{courier_List_ID}"
                       data-name="{courier_Name}"
                       data-contactperson="{contact_Person}"
                       data-contactno="{contact_Phone}">
                        Edit
                    </a>

                </div>

            </div>

        </td>

    </tr>

</template>