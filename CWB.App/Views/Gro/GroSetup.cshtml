@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<div class="content">
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h4 class="m-0">Gro Sales Data Management Setup</h4>
                @{
                    List<CWB.App.Models.EmployeeMaster.Role_UI_ListVM> permissionResult = null;
                    var permissionsJson = HttpContextAccessor.HttpContext.Session.GetString("Permissions");
                    if (permissionsJson != null)
                    {
                        permissionResult = Newtonsoft.Json.JsonConvert.DeserializeObject<List<CWB.App.Models.EmployeeMaster.Role_UI_ListVM>>(permissionsJson);

                    }
                }
                <a asp-action="Index"
                   asp-controller="Gro"
                   id="CloseBtn"
                   style="font-size:24px; color:#000; text-decoration:none;">
                    X
                </a>
            </div>

            <!-- Upload Section -->
            <!-- Gro Part List Update -->


            <div class="row align-items-center">
                <div class="col-md-4">
                    <h5>Gro Part List Update</h5>
                </div>
                <div class="col-md-3 text-end">
                    <button class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#groPartListModal">
                        Part List
                    </button>
                </div>
            </div>
            <hr />

            <!-- Courier List Update -->

            <div class="row align-items-center">
                <div class="col-md-4">
                    <h5>Courier List Update</h5>
                </div>
                <div class="col-md-3 text-end">
                    <button class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#courierListModal"
                             onclick="loadCourierList()">
                        Courier List
                    </button>
                </div>
            </div>

            <hr />
            <!-- Gro Field List Update -->
            <!--<div class="row align-items-center">
                <div class="col-md-4">
                    <h5>Gro Field List Update</h5>
                </div>
                <div class="col-md-3 text-end">
                    <button class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#groFieldListModal">
                        Field List
                    </button>
                </div>
            </div>
            <hr />-->
            <!-- Gro Upload File Details -->
            <!--<div class="row align-items-center">
                <div class="col-md-4">
                    <h5>Gro Upload File Details</h5>
                </div>
                <div class="col-md-3 text-end">
                    <button class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#groUploadDetailsModal">
                        Upload Details
                    </button>
                </div>
            </div>
            <hr />-->
            <div class="row align-items-center">
                <div class="col-md-4">
                    <h5>Invoice/ DC Control</h5>
                </div>
                <div class="col-md-3 text-end">
                    <button class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#groInvDcControlModal"
                             onclick="loadInvDcControl()">
                        Inv / DC
                    </button>
                </div>
            </div>
            <hr />


        </div>
    </div>
</div>
@section scripts {
    <script src="~/js/gro/grosetup.js"></script>


}

