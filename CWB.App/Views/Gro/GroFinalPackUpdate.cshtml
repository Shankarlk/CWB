@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<style>
    #editDispatchAddressModal, #editDispatchAddressUpdateModal {
        z-index: 1065 !important;
    }

    #DCPreview,
    #DCPreview * {
        border-color: #000 !important;
    }

        #DCPreview .border,
        #DCPreview .border-top,
        #DCPreview .border-bottom,
        #DCPreview .border-start,
        #DCPreview .border-end,
        #DCPreview table,
        #DCPreview th,
        #DCPreview td {
            border-width: 1.5px !important;
        }

    .modal-stack-blur {
        filter: blur(10px);
        pointer-events: none;
        user-select: none;
    }
</style>
<div class="content">
    <div class="card">
        <div class="card-body">
            <h4 class="pb-1 mt-1 mb-1">Final Pack Update Page</h4>

            @{
                List<CWB.App.Models.EmployeeMaster.Role_UI_ListVM> permissionResult = null;
                var permissionsJson = HttpContextAccessor.HttpContext.Session.GetString("Permissions");
                if (permissionsJson != null)
                {
                    permissionResult = Newtonsoft.Json.JsonConvert.DeserializeObject<List<CWB.App.Models.EmployeeMaster.Role_UI_ListVM>>(permissionsJson);

                }
            }
            <!-- Upload Section -->

             


            <!-- Dispatch Qty -->

            <div class="row">
                <div class="col-md-12">
                    <h5> Indents to be Packed</h5>
                    <h5 class="text-center"> Ageing</h5>

                    <div class="table-responsive">
                        <table class="table table-bordered text-center">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>0</th>
                                    <th>1</th>
                                    <th>2</th>
                                    <th>3</th>
                                    <th>> 3</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>

                                <tr>
                                    <td>Full Qty to be Dispatched</td>

                                    <td id="full0"></td>
                                    <td id="full1"></td>
                                    <td id="full2"></td>
                                    <td id="full3"></td>
                                    <td id="fullgt3"></td>
                                    <td id="fulltotal"></td>
                                </tr>

                                <tr>
                                    <td>Partial Qty to be Dispatched</td>

                                    <td id="partial0"></td>
                                    <td id="partial1"></td>
                                    <td id="partial2"></td>
                                    <td id="partial3"></td>
                                    <td id="partialgt3"></td>
                                    <td id="partialtotal"></td>
                                </tr>

                                <tr hidden>
                                    <td>Qty not Dispatched</td>

                                    <td id="none0"></td>
                                    <td id="none1"></td>
                                    <td id="none2"></td>
                                    <td id="none3"></td>
                                    <td id="nonegt3"></td>
                                    <td id="nonetotal"></td>
                                </tr>

                                <tr>

                                    <td><b>Total</b></td>

                                    <td id="total0"></td>
                                    <td id="total1"></td>
                                    <td id="total2"></td>
                                    <td id="total3"></td>
                                    <td id="totalgt3"></td>
                                    <td id="grandtotal"></td>

                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                 
            </div>


            
            


            


          

            <div class="row justify-content-center">
                <div class="col-md-6 text-center">
                    <button class="btn btn-primary gro-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#dispatchPopup">
                       Update Dispatch Qnty
                    </button>
                </div>

                
            </div>
            

           




        </div>
    </div>
</div>
@section scripts {
    <script src="~/js/gro/grofinalpack.js"></script>


}

 
@* popup 1 Dispatch selection popup *@
<div class="modal fade" id="dispatchPopup" tabindex="-1" data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog modal-full-width">
        <div class="modal-content border border-4 border-primary">

            <div class="modal-header">
                <h4 class="modal-title">
                    Gro - Dispatch Selection
                </h4>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                <div class="mb-2" id="divAgeingInfo" style="display:none;">
                    <strong>Ageing :</strong>
                    <span id="lblAgeing"></span>
                </div>
                <!-- Filters -->
                <div class="row mb-3">

                    <div class="col-md-3">
                        <label>Indent</label>
                        <input type="text"
                               class="form-control"
                               id="txtIndentSearch"
                               placeholder="Search Indent">
                    </div>

                    <div class="col-md-3">
                        <label>From Date</label>
                        <input id="txtFromDate" type="date" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>To Date</label>
                        <input id="txtToDate" type="date" class="form-control">
                    </div>

                    <div class="col-md-3">
                        <label>Dispatch Status</label>
                        <select class="form-select" id="ddlDispatchStatus">
                            <option value="All">All</option>
                            <option value="No Dispatch">No Dispatch</option>
                            <option value="Partial Dispatch">Partial Dispatch</option>
                        </select>
                    </div>


                </div>
                <div class="row mb-3">
                    <div class="col-md-3">
                        <button type="button" id="btnClearFilter" class="btn btn-secondary w-100">
                            Clear
                        </button>
                    </div>
                </div>
                <!-- Select All -->
                <div class="form-check mb-3">
                    <input class="form-check-input"
                           type="checkbox"
                           id="chkAll">

                    <label class="form-check-label"
                           for="chkAll">
                        Select All
                    </label>
                </div>

                <!-- Grid -->
                <div class="table-responsive  table-he-250">
                    <table class="table table-sm table-bordered w-100 text-center" id="Dispatchselectiontable">
                        <thead class=" table-info th-sti">
                            <tr class="table-border-bottom">
                                <th></th>
                                <th>Indent Date</th>
                                <th>Indent No</th>
                                <th>Customer</th>
                                <th>Product</th>
                                <th>Order Qty</th>
                                <th>Bal Disp Qty</th>
                                <th>Qnty Avl</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                        </tbody>

                    </table>
                </div>

            </div>

            <div class="modal-footer">
                <button id="updatedispatchqnty" class="btn btn-primary" disabled
                        data-bs-toggle="modal"
                        data-bs-target="#dispatchQtyModal">
                    Update Dispatch Qty
                </button>


            </div>

        </div>
    </div>
</div>
