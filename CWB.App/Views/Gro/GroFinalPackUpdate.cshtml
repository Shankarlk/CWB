@* popup3 :popup to enter dispatch Quantity for unique Indent *@
<div class="modal fade"
     id="dispatchQtyModal"
     tabindex="-1"
     aria-labelledby="dispatchQtyModalLabel" data-bs-backdrop="static"
     data-bs-keyboard="false"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content border border-4 border-primary">

            <div class="modal-header">
                <h5 class="modal-title" id="dispatchQtyModalLabel">
                    Gro - Dispatch Quantity Update
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="hdnGroDispHeaderId" />
                <input type="hidden" id="hdnIndentId" />
                <!-- Header Information -->

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div><strong>Indent Date :</strong> <span id="IndentDate"></span></div>
                        <div><strong>Indent No :</strong> <span id="IndentNo"></span></div>
                        <div><strong>Customer :</strong> <span id="Customer"></span></div>

                        <div><strong>Address :</strong> <span id="Address"></span></div>
                        <div><strong>Contact :</strong> <span id="Contact"></span></div>
                        <div><strong>Cell Phone :</strong> <span id="Mobile"></span></div>
                        <div><strong>Executive :</strong> <span id="Executive"></span></div>
                    </div>
                </div>

                <!-- Product Grid -->

                <div class="table-responsive mb-2 table-he-350">
                    <table class="table table-sm table-bordered w-100 text-center" id="Dispheadertable">
                        <thead class="table-info th-sti">
                            <tr class="table-border-bottom">
                                <th >Part No/Desc</th>
                                <th style="width:80px;">Order Qty</th>
                                <th style="width:80px;">Qnty Avl</th>
                                <th style="width:80px;">Disp.Till Date </th>
                                <th style="width:80px;">Bal Disp Qty</th>
                                <th style="width:80px;">DispQty Scanned </th>
                                <th style="width:10px;"></th>
 
                            </tr>
                        </thead>

                        <tbody>
                        </tbody>

                    </table>

                </div>

            </div>

            <div class="modal-footer justify-content-between">

                <button class="btn btn-primary" data-bs-toggle="modal"
                        data-bs-target="#editDispatchAddressModal"
                        onclick="loadDispatchAddress()">
                    Edit Dispatch Address
                </button>

                <button class="btn btn-primary" id="btnReadyDispatch">
                    Ready for Dispatch
                </button>
                <button class="btn btn-primary"
                        id="btnPrintAddressLabel"
                        data-bs-toggle="modal"
                        data-bs-target="#AddressLabelModal">
                    Print Address Label
                </button>
                <button class="btn btn-primary" id="btnOpenDCPrint"
                        data-bs-toggle="modal"
                        data-bs-target="#DCPrintModal">
                    Print DC
                </button>
                <button class="btn btn-primary" id="btnPrintInvoice"
                        data-bs-toggle="modal"
                        data-bs-target="#InvoicePrintModal">
                    Print Invoice
                </button>
            </div>

        </div>

    </div>

</div>
<!-- Popup 4 : Dispatch Quantity Entry -->
<div class="modal fade"
     id="lineItemDispatchQtyModal"
     tabindex="-1" data-bs-backdrop="static"
     data-bs-keyboard="false"
     aria-labelledby="lineItemDispatchQtyModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-md">

        <div class="modal-content border border-4 border-primary">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="lineItemDispatchQtyModalLabel">
                    Gro Dispatch Qty Entry for Line Item
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <!-- Hidden Fields -->
                <input type="hidden" id="hdnDispDetailId" />
                <input type="hidden" id="hdnPartId" />

                <!-- Header Details -->

                <div class="row mb-1">
                    <div class="col-5"><strong>Indent Date</strong></div>
                    <div class="col-7">: <span id="liIndentDate"></span></div>
                </div>

                <div class="row mb-1">
                    <div class="col-5"><strong>Indent No</strong></div>
                    <div class="col-7">: <span id="liIndentNo"></span></div>
                </div>

                <div class="row mb-1">
                    <div class="col-5"><strong>Part No / Desc</strong></div>
                    <div class="col-7">: <span id="liPartNo"></span></div>
                </div>

                <div class="row mb-1">
                    <div class="col-5"><strong>Order Qty</strong></div>
                    <div class="col-7">: <span id="liOrderQty"></span></div>
                </div>

                <div class="row mb-1">
                    <div class="col-5"><strong>Dispatch To Date</strong></div>
                    <div class="col-7">: <span id="liDispTillDate"></span></div>
                </div>

                <div class="row mb-4">
                    <div class="col-5"><strong>Quantity On Hand</strong></div>
                    <div class="col-7">: <span id="liQtyOnHand"></span></div>
                </div>

                <!-- Scan Button -->

                <div class="row mb-4">
                    <div class="col text-center">
                        <button class="btn btn-primary"
                                id="btnScanLabel">
                            Scan Label
                        </button>
                    </div>
                </div>
                <!-- Last Scanned Label -->

                <div class="row mb-3 align-items-center">

                    <label class="col-6 col-form-label">
                        Last Scanned QR Code
                    </label>

                    <div class="col-6">

                        <input type="text"
                               class="form-control"
                               id="txtDispatchScannedQRCode"
                               placeholder="Waiting for scan..."
                               autocomplete="off" />

                    </div>

                </div>
                <!-- Balance -->

                <div class="row mb-3 align-items-center">

                    <label class="col-6 col-form-label">
                        Balance to Dispatch
                    </label>

                    <div class="col-3">
                        <input type="text"
                               class="form-control text-center"
                               id="txtBalanceDispatch"
                               readonly />
                    </div>

                </div>

                <!-- Scanned Qty -->

                <div class="row mb-4 align-items-center">

                    <label class="col-6 col-form-label">
                        Scanned Quantity
                    </label>

                    <div class="col-3">
                        <input type="text"
                               class="form-control text-center"
                               id="txtScannedQty"
                               readonly />
                    </div>

                </div>

                <!-- Status -->

                <div class="row mb-4">

                    <div class="col-12">

                        <input type="text"
                               class="form-control"
                               id="txtDispatchStatus"
                               readonly />

                    </div>

                </div>

            </div>

            <div class="modal-footer justify-content-center">

                <button class="btn btn-primary"
                        id="btnSaveExitDispatch">
                    Save &amp; Exit
                </button>

            </div>

        </div>

    </div>

</div>
