@* Dc Printing  popup *@
<!-- DC Print Modal -->
<div class="modal fade"
     id="DCPrintModal"
     tabindex="-1"
     aria-labelledby="DCPrintModalLabel"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
