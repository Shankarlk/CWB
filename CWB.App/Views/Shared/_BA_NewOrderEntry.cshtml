                                </div>
                                <div class="col-md-3" style="padding-left: 45px;">
                                    <label class="form-label col-md-4 mb-2">
                                        Total : <span id="TotalPoQnty">0</span>
                                    </label>
                                </div>
                                <div class="col-md-3">
                                </div>
                                <div class="col-md-3" style="padding-left: 30px;">
                                    <label class="form-label col-md-4 mb-2">
                                        Total : <span id="TotalPlanQnty">0</span>
                                    </label>
                                </div>

                            </div>
                        </div>
                        <!-- ================  -->
