
@{
    ViewData["Title"] = "View Shop Loading";
}
<input value="I-VSL" type="hidden" id="hdn-nav-menu" />
<div class="content">
    <div class="row">
        <div class="col-xl-12 col-md-12 col-sm-12 col-xs-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-11">
                            <h5 class="mb-4">Parts loaded in Shop</h5>
                        </div>
                        <div class="col-md-1 text-end">
                            <a asp-action="Index" asp-controller="InfoQueries" id="CloseBtn" style="font-size: large; color: #000;">
                                X
                            </a>
                        </div>
                        <div class="col-md-2 mb-2">
                            <label class="form-label">Shop </label>
                            <select class="form-select form-select-sm" aria-label="form-select-sm"
                                    id="P4Shop" title="" data-plugin="tippy" data-tippy-placement="top">
                                <option value="">==========</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-2">
                            <label class="form-label">Machine </label>
                            <select class="form-select form-select-sm" aria-label="form-select-sm"
                                    id="P4McName" title="" data-plugin="tippy" data-tippy-placement="top">
                                <option value="">==========</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-2">
                            <label class="form-label">Part No / Desc </label>
                            <input type="text" id="P4PartNo" class="form-control form-control-sm" placeholder="Part No / Desc" />
                        </div>
                        <div class="col-md-12" id="P6partInspectPlanGridDiv">
                            <div class="col-md-12">
                                <div class="table-responsive table-he-330">
                                    <table id="P4Grid"
                                           class="table table-sm table-bordered w-100 text-center">
                                        <thead class="  table-info th-sti">
                                            <tr class="table-border-bottom">
                                                <th>Shop</th>
                                                <th>Work Ref </th>
                                                <th>Machine</th>
                                                <th>Part No / Desc</th>
                                                <th>Seq No </th>
                                                <th>WO Qnty</th>
                                                <th>Bal To Bookout</th>
                                                <th>Qnty W/f Processing</th>
                                                <th>Bal time for Avl Qnty Hrs</th>
                                                <th>Part in M/c</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- -------------  -->
                                            <!-- -------------  -->
                                            <!-- -------------  -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- ========================= -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<template id="P4GridRow">
    <tr>
        <td>{shopName}</td>
        <td>{woNumber}</td>
        <td>{mcName}</td>
        <td>{partNo}</td>
        <td>{wait_Seq_No}</td>
        <td>{woQnty}</td>
        <td>{bal_Qnty}</td>
        <td>{qtyWfProcessing}</td>
        <td>{balTimeForAvlQtyHrs}</td>
        <td>{partInMc}</td>
    </tr>
</template>
@section Scripts {
    <script src="~/js/ViewShopLoad.js"></script>
}