
@{
    ViewData["Title"] = "View Work Order List";
}
<input value="I-VW" type="hidden" id="hdn-nav-menu" />
<div class="content">
    <div class="row">
        <div class="col-xl-12 col-md-12 col-sm-12 col-xs-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-11">
                            <h5 class="mb-4"> View Work Order List</h5>
                        </div>
                        <div class="col-md-1 text-end">
                        </div>
                        <!-- -----------------  -->
                        <div class="col-md-2 mb-2" style="margin-top: -2px;">
                            <label class="form-label">Part No</label>
                            <div class="input-group">
                                <input class="form-control form-control-sm" type="text" title=""
                                       data-plugin="tippy" data-tippy-placement="top"
                                       placeholder="Enter Part No" id="searchPartNo">
                                @*<button type="button" id="#" class="btn btn-sm btn-outline-dark"
                                            title="Search Part No" data-plugin="tippy" data-tippy-placement="top"
                                            data-bs-toggle="modal" data-bs-target="#">
                                        <i class="ri-search-2-line serch-part-btn1"></i>
                                    </button>*@
                            </div>
                        </div>
                        <!-- -----------------  -->
                        <!-- -----------------  -->
                        <div class="col-md-4 mb-2">
                            <label class="form-label">Part Description</label>
                            <input class="form-control form-control-sm" type="text" placeholder="Enter here"
                                   title="" data-plugin="tippy" data-tippy-placement="top" id="searchPartDesc">
                        </div>
                        <!-- -----------------  -->
                        <div class="col-md-2 mb-2">
                            <label class="form-label">Work Order</label>
                            <input class="form-control form-control-sm" type="text" placeholder="Enter here"
                                   title="" data-plugin="tippy" data-tippy-placement="top" id="searchWo">
                        </div>
                        <!-- -----------------  -->
                        <div class="col-md-2 mb-2">
                            <label class="form-label">Status</label>
                            <input class="form-control form-control-sm" type="text" placeholder="Enter"
                                   title="" data-plugin="tippy" data-tippy-placement="top" id="searchStatus">
                        </div>
                        <!-- -----------------  -->
                        <div class="col-md-2 mb-2">
                            <label class="form-label">Part Type</label>
                            <select class="form-select form-select-sm" aria-label="form-select-sm" title=""
                                    data-plugin="tippy" data-tippy-placement="top" id="searchPartType">
                                <option value="0">All</option>
                                <option value="2">Assembly</option>
                                <option value="1">Child Part</option>
                            </select>
                        </div>
                        <!-- -----------------  -->
                        <div class="col-md-2 mb-2">
                            <label class="form-label">WO Compl Dt from</label>
                            <input class="form-control form-control-sm" type="date" title=""
                                   data-plugin="tippy" data-tippy-placement="top" id="WoComplDtFrom">
                        </div>
                        <!-- ========================= -->
                        <div class="col-md-2 mb-2">
                            <label class="form-label">WO Compl Dt To</label>
                            <input class="form-control form-control-sm" type="date" title=""
                                   data-plugin="tippy" data-tippy-placement="top" id="WoComplDtTo">
                        </div>
                        <div class="col-md-2 mb-2 mt-2">
                            <button id="btnClear" class="btn btn-sm btn-outline-purple mt-2" title=""
                                    data-plugin="tippy" data-tippy-placement="top">
                                Clear The Fields
                            </button>
                        </div>
                        <!-- ======================== -->
                        <!-- -----------------  -->
                        <!-- ======================== -->
                    </div>
                    <!-- =========== -->
                    <div class="row mt-3">
                        <div class="col-md-12">
                            <div class="table-responsive table-he-250">
                                <table class="table table-sm table-bordered w-100 text-center" id="WorkOrderList">
                                    <thead class="  table-info th-sti">
                                        <tr class="table-border-bottom">
                                            <th>Work Order</th>
                                            <th>Build to Stock</th>
                                            <th>Part No / Desc</th>
                                            <th>W/O Qnty</th>
                                            <th>W/O Date</th>
                                            <th>W/O Compl Date</th>
                                            <th>Status</th>
                                            <th>Hold</th>
                                            <th>Matl</th>
                                            <th>WIP</th>
                                            <th>Done</th>
                                            <th>NC</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        <!-- -------------  -->
                                        <!-- -------------  -->
                                    </tbody>
                                </table>
                            </div>
                            <!-- ===========================  -->
                        </div>
                        <!-- =======================  -->
                        @*<div class="col-md-12 text-end">
                                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#popup3">Build to Stock</button>
                            </div>*@
                        <!-- =========== -->
                    </div>
                    <!-- =========== -->
                </div>
                <!-- end card body -->
            </div>
            <!-- end card -->
            <!-- ================= -->
        </div>
        <!-- end col -->
    </div>
    <!-- end row -->
</div>

<div class="modal fade" id="ViewSoLog" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-full-width">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="standard-modalLabel">WO Log : <span id="SpanSoNumber"></span>                <span style="padding:100px">WO Date : <span id="SoDateSpan"></span>	<span id="SoPartNoSPan"></span><span id="SoPartDescSPan"></span></span>	</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-2 mb-2">
                        <label class="form-label">WO Compl Dt from</label>
                        <input class="form-control form-control-sm" type="date" title=""
                               data-plugin="tippy" data-tippy-placement="top" id="SoLogcomplDtFrom">
                    </div>
                    <!-- ========================= -->
                    <div class="col-md-2 mb-2">
                        <label class="form-label">WO Compl Dt To</label>
                        <input class="form-control form-control-sm" type="date" title=""
                               data-plugin="tippy" data-tippy-placement="top" id="SoLogcomplDtTo">
                    </div>
                    <div class="col-md-2 mb-2">
                        <label class="form-label">Part No</label>
                        <input class="form-control form-control-sm" type="text" title=""
                               data-plugin="tippy" data-tippy-placement="top"
                               placeholder="Enter Location" id="searchLogPartNo">
                    </div>
                    <!-- -----------------  -->
                    <div class="col-md-2 mb-2">
                        <label class="form-label">Event</label>
                        <input class="form-control form-control-sm" type="text" title=""
                               data-plugin="tippy" data-tippy-placement="top"
                               placeholder="Enter MC Type" id="searchEventLog">
                    </div>
                    <!-- -----------------  -->
                    <!-- -----------------  -->
                    <div class="col-md-2 mb-2">
                        <label class="form-label">Comment</label>
                        <input class="form-control form-control-sm" type="text" title=""
                               data-plugin="tippy" data-tippy-placement="top"
                               placeholder="Enter Machine" id="searchLogComment">
                    </div>
                    <!-- ======================== -->
                    <div class="col-md-12">
                        <div class="table-responsive table-he-250">
                            <table class="table table-sm table-bordered w-100 text-center" id="WoLogGrid">
                                <thead class="  table-info th-sti">
                                    <tr class="table-border-bottom">
                                        <th>Date/Time</th>
                                        <th>User</th>
                                        <th>Event</th>
                                        <th>Field</th>
                                        <th>New Value</th>
                                        <th>Old Value</th>
                                        <th>Comment</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- -------------  -->
                                    <!-- -------------  -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- -----------------  -->
                </div>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>


<template id="WorkOrderListRow">
    <tr>
        <td hidden>{woid}</td>
        <td hidden>{salesOrderId}</td>
        <td hidden>{partId}</td>
        <td>{woNumber}</td>
        <td>{buildToStock}</td>
        <td>{partNo}/{partDesc}</td>
        <td>{calcWOQty}</td>
        <td>{woDateStr}</td>
        <td>{planCompletionDateStr}</td>
        <td>{strStatus}</td>
        <td hidden>{partType}</td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td>
            <div class="dropdown float-center">
                <a href="#" class="dropdown-toggle arrow-none card-drop"
                   data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="mdi mdi-dots-vertical"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-end">
                    <!-- item-->
                    <!-- item-->
                        <a href="javascript:void(0);"
                           class="dropdown-item" data-bs-toggle="modal"
                           data-workorderid={woid}
                           data-salesorderid={salesOrderId}
                           data-wonumber={woNumber}
                           data-partno={partNo}
                           data-partdesc={partDesc}
                           data-partid={partId}
                           data-parttype={partType}
                           data-plancompletiondatestr='{planCompletionDateStr}'
                           data-requiredquantity={requiredQuantity}
                           data-calwoqty={calcWOQty}
                           data-wostatus={status}
                           data-buildtostock={buildToStock}
                           data-routingid={routingId}
                           data-startingopno={startingOpNo}
                           data-endingopno={endingOpNo}
                           data-bs-target="#ViewSoLog">View Wo Log</a>
                    <!-- item-->
                </div>
            </div>
        </td>
    </tr>
</template>


